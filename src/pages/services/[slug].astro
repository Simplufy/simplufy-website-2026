---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContactForm from '../../components/ContactForm.astro';
import FAQ from '../../components/FAQ.astro';
import Icon from '../../components/Icon.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import ScreenshotCard from '../../components/ScreenshotCard.astro';
import PhotoFrame from '../../components/PhotoFrame.astro';
import { servicePhotos, serviceImages } from '../../data/photos';
import PageArchitecture from '../../components/motion/PageArchitecture.astro';
import CRMPipeline from '../../components/motion/CRMPipeline.astro';
import PPCQueryMatch from '../../components/motion/PPCQueryMatch.astro';
import AdCreativeBoard from '../../components/motion/AdCreativeBoard.astro';
import LSATrustPath from '../../components/motion/LSATrustPath.astro';
import SearchVisibilityMap from '../../components/motion/SearchVisibilityMap.astro';
import AIWorkflowArchitecture from '../../components/motion/AIWorkflowArchitecture.astro';
import { services, industries, caseStudies, site } from '../../data/site';
import { serviceDetails } from '../../data/serviceDetails';
import { faqs as globalFaqs } from '../../data/faqs';

export function getStaticPaths(){ return services.map(service => ({ params:{ slug: service.slug }, props:{ service }})); }
const { service } = Astro.props;
const detail = serviceDetails[service.slug];

/* ---------- Per-service FAQ content (preserved) ---------- */
const serviceFaqsBySlug: Record<string, { q: string; a: string }[]> = {
  'web-development': [
    { q:'When should a service business rebuild its website instead of editing the old one?', a:'A rebuild makes sense when the homepage cannot explain the offer quickly, service pages are too thin to rank, mobile visitors have to work too hard, or forms and calendars do not connect to the follow-up process. For web development, Simplufy looks at trust, conversion paths, technical SEO, page speed, and whether the site gives each buyer type a clear next step.' },
    { q:'Will the website be built for SEO from the start?', a:'Yes. Web development work includes crawlable static pages, semantic headings, internal links, service and industry page architecture, metadata, schema, image alt text, and fast Cloudflare-ready performance. The goal is a site that looks premium and gives Google enough context to understand what Simplufy or the client actually offers.' },
    { q:'Can you connect forms, calendars, and CRM tracking?', a:'Yes. A website should not end at a form submit. Simplufy can connect GoHighLevel forms, booking calendars, tracking scripts, thank-you paths, CRM stages, and follow-up workflows so the site becomes part of the sales system.' }
  ],
  'crm-solutions': [
    { q:'What CRM problems does Simplufy usually fix first?', a:'The first fixes are usually lead routing, missed-call recovery, calendar reminders, pipeline stages, source tracking, and follow-up timing. If a good lead enters the business but nobody knows who owns it, what stage it is in, or when the next touch happens, the CRM is costing revenue.' },
    { q:'Do CRM automations replace the sales team?', a:'No. CRM automation should protect the sales team from repetitive gaps, not pretend the human relationship does not matter. The strongest systems send reminders, route leads, capture notes, trigger confirmations, and keep the next step clear while the team handles the actual conversation.' },
    { q:'Can this work with GoHighLevel?', a:'Yes. Simplufy builds GoHighLevel pipelines, forms, calendars, workflows, SMS/email follow-up, missed-call text-back, task creation, reporting views, and campaign attribution when GoHighLevel is the right operating system for the business.' }
  ],
  'google-ppc-management': [
    { q:'What makes Google PPC different from other paid media?', a:'Google PPC captures people already searching for a service, location, problem, or company. The work is less about creating demand from scratch and more about matching search intent with the right ad, landing page, offer, tracking, and follow-up path.' },
    { q:'Why do Google Ads campaigns fail even with good keywords?', a:'Campaigns often fail because traffic lands on a weak page, calls are not tracked, forms do not route into a CRM, negative keywords are ignored, or the offer does not match the search. Simplufy reviews the entire path from query to booked opportunity instead of only changing bids.' },
    { q:'Will reporting show booked opportunities, not just clicks?', a:'That is the goal. Google PPC management should connect conversion tracking, call tracking, form submissions, CRM stages, and sales feedback so budget decisions are based on lead quality and booked opportunities instead of surface-level traffic metrics.' }
  ],
  'meta-advertising': [
    { q:'What types of businesses are a good fit for Meta Ads?', a:'Meta Ads work well when the offer can be explained visually, when proof matters, when retargeting can warm up visitors, or when the business has a lead magnet, consultation, seasonal promotion, or high-value service that benefits from repeated exposure.' },
    { q:'How do you avoid low-quality Facebook leads?', a:'Lead quality improves when the creative pre-qualifies the buyer, the form asks the right friction questions, the offer is clear, and the CRM follow-up happens fast. Simplufy also separates testing, retargeting, and higher-intent paths so cheap form fills do not get mistaken for real pipeline.' },
    { q:'Do Meta campaigns need landing pages?', a:'Sometimes native lead forms are best for speed; other times landing pages are better for education, proof, and higher-intent conversion. Simplufy chooses the path based on the offer, ticket size, sales cycle, and how much trust the buyer needs before taking action.' }
  ],
  'google-local-service-ads': [
    { q:'Who is eligible for Google Local Service Ads?', a:'Eligibility depends on the industry, location, licensing, background checks, verification status, and Google’s current category rules. Simplufy starts by checking category fit and account readiness before treating LSA as a viable lead source.' },
    { q:'Why do LSAs need active management?', a:'Local Service Ads depend on reviews, response speed, call quality, dispute review, category fit, budget pacing, and lead feedback. If calls are missed, weak, or miscategorized, the account can spend without producing profitable jobs.' },
    { q:'Can LSA calls be routed into CRM follow-up?', a:'Yes. LSA performance improves when calls, missed calls, booked appointments, job notes, and follow-up tasks are tracked instead of living only inside the ad platform or a phone log.' }
  ],
  'tiktok-ad-management': [
    { q:'When does TikTok make sense for a service business?', a:'TikTok makes sense when the business can show transformations, demonstrations, founder education, behind-the-scenes proof, strong hooks, or visual outcomes. It is usually strongest as an awareness, retargeting, and creative-learning channel rather than a standalone magic lead source.' },
    { q:'What does Simplufy test on TikTok?', a:'Testing focuses on hooks, video formats, proof angles, offer framing, audience response, landing paths, and retargeting sequences. Short-form creative should teach the rest of the marketing system what buyers actually stop and care about.' },
    { q:'How is TikTok connected to the rest of the funnel?', a:'TikTok traffic can support landing pages, lead forms, remarketing audiences, CRM nurture, and creative insights for Meta, website copy, and sales enablement. The channel works best when it has a clear next step after the view.' }
  ],
  'seo-aeo-geo': [
    { q:'How are SEO, AEO, and GEO different on a real website?', a:'SEO helps pages rank in Google. AEO structures pages so they answer buyer questions clearly. GEO improves how the brand and content can be understood by AI-driven search and answer systems. On the site, that means stronger architecture, clearer entities, better FAQs, schema, proof, and content built around real search intent.' },
    { q:'What pages should a service business build first?', a:'The first pages usually cover core services, high-intent industries, profitable locations, comparison questions, pricing or process questions, and proof. Simplufy prioritizes based on buyer intent, revenue potential, competition, and whether the page can support paid traffic as well as organic search.' },
    { q:'How do you measure search visibility beyond rankings?', a:'Search visibility is reviewed through impressions, clicks, qualified inquiries, map and local intent, AI/answer presence, content coverage, internal linking, conversion rates, and whether traffic turns into booked opportunities.' }
  ],
  'ai-implementation-agent-orchestration': [
    { q:'What kind of AI implementation is practical for service companies?', a:'Practical AI usually starts with reporting summaries, lead intake support, research, content drafting, CRM task assistance, proposal prep, knowledge-base retrieval, and internal handoff workflows. The best first use cases remove repetitive work without giving an unsupervised system control over sensitive decisions.' },
    { q:'How do you keep AI workflows reliable?', a:'Simplufy designs AI systems with clear inputs, narrow tasks, human review points, approval steps, logging, and fallback paths. The goal is useful leverage, not a fragile black box that produces work nobody can trust.' },
    { q:'Can AI connect to CRM, ads, content, and operations?', a:'Yes, when the workflow is designed carefully. AI can summarize lead context, draft follow-up, prepare reports, support content production, research accounts, and help coordinate handoffs between tools, but it should be orchestrated around real business rules.' }
  ]
};
const serviceFaqs = serviceFaqsBySlug[service.slug] ?? globalFaqs.slice(0, 3);

/* ---------- Hero: service motion component map ---------- */
const heroVisualMap: Record<string, { component: any; props?: Record<string, unknown> }> = {
  'web-development': { component: PageArchitecture },
  'crm-solutions': { component: CRMPipeline, props: { compact: true } },
  'google-ppc-management': { component: PPCQueryMatch },
  'meta-advertising': { component: AdCreativeBoard, props: { platform: 'meta' } },
  'google-local-service-ads': { component: LSATrustPath },
  'tiktok-ad-management': { component: AdCreativeBoard, props: { platform: 'tiktok' } },
  'seo-aeo-geo': { component: SearchVisibilityMap },
  'ai-implementation-agent-orchestration': { component: AIWorkflowArchitecture }
};
const heroVisual = heroVisualMap[service.slug];
const HeroVisual = heroVisual.component;

/* ---------- H1 accent word (one Fraunces-italic phrase per headline) ---------- */
const accentPhrases: Record<string, string> = {
  'web-development': 'trust',
  'crm-solutions': 'slipping away',
  'google-ppc-management': 'high-intent',
  'meta-advertising': 'demand',
  'google-local-service-ads': 'eligible',
  'tiktok-ad-management': 'visual offers',
  'seo-aeo-geo': 'AI answers',
  'ai-implementation-agent-orchestration': 'repetitive work'
};
const phrase = accentPhrases[service.slug];
const phraseIndex = phrase ? service.title.indexOf(phrase) : -1;
const titleParts = phraseIndex !== -1
  ? { before: service.title.slice(0, phraseIndex), match: phrase, after: service.title.slice(phraseIndex + phrase.length) }
  : null;

/* ---------- Problem headlines ---------- */
const problemHeadings: Record<string, string> = {
  'web-development': 'Traffic arrives. Nothing gets booked.',
  'crm-solutions': 'The leads exist. The follow-up does not.',
  'google-ppc-management': 'Clicks get bought. Opportunities go missing.',
  'meta-advertising': 'The platform gets blamed. The system is the issue.',
  'google-local-service-ads': 'Top of local search, bottom of the call log.',
  'tiktok-ad-management': 'Cheap attention with no business destination.',
  'seo-aeo-geo': 'Search split into three surfaces. Most sites are invisible on all of them.',
  'ai-implementation-agent-orchestration': 'Most AI projects fail in predictable ways.'
};
const problemHeading = problemHeadings[service.slug] ?? 'The problem is usually the system, not the channel.';

/* ---------- Proof: real screenshots only; never fabricated ---------- */
type ProofShot = { src: string; alt: string; label?: string; metric?: string; note?: string };
type ProofConfig =
  | { kind: 'rebuild'; eyebrow: string; heading: string; body: string }
  | { kind: 'shots'; eyebrow: string; heading: string; body: string; shots: ProofShot[] }
  | { kind: 'cases'; eyebrow: string; heading: string; body: string; caseSlugs: string[] };

const proofBySlug: Record<string, ProofConfig> = {
  'web-development': {
    kind: 'rebuild',
    eyebrow: 'Before / after rebuild',
    heading: 'State Termite went from dated and crowded to focused, modern, and conversion-led.',
    body: 'The old site relied on heavy red and blue navigation, crowded banners, and mixed priorities. The rebuild uses a cleaner brand system, stronger hierarchy, a direct protection-plan CTA, and an above-the-fold form built around lead capture.'
  },
  'crm-solutions': {
    kind: 'shots',
    eyebrow: 'Real pipeline',
    heading: 'The pipeline a Detail Depot lead actually enters.',
    body: 'Every estimate request gets an owner, a stage, and a follow-up timer. This board tracked $83,260 in opportunity value, so budget decisions came from booked work instead of lead counts.',
    shots: [
      { src:'/assets/case-studies/detail-depot/detail-depot-crm-pipeline.png', alt:'Detail Depot CRM pipeline showing lead stages from submitted form to job complete with tracked opportunity value', label:'CRM pipeline', metric:'$83,260', note:'Tracked opportunity value, Detail Depot' }
    ]
  },
  'google-ppc-management': {
    kind: 'shots',
    eyebrow: 'Real account',
    heading: 'Hyper-local search spend with the receipts attached.',
    body: 'JP Mobile Detail routed high-intent local searches into a frictionless booking engine: 1,087 clicks, 31 primary bookings, and a $15.51 cost per booking. The account optimized toward bookings, not clicks.',
    shots: [
      { src:'/assets/case-studies/jp-mobile-detail/jp-mobile-detail-google-ads-performance.png', alt:'JP Mobile Detail Google Ads dashboard showing 1,087 clicks at $0.44 average CPC and 31 conversions', label:'Google Ads performance', metric:'$0.44 avg CPC', note:'1,087 clicks, 31 bookings at $15.51 CPA, JP Mobile Detail' }
    ]
  },
  'meta-advertising': {
    kind: 'shots',
    eyebrow: 'Real campaigns',
    heading: 'Two offers, two markets, one creative-testing system.',
    body: 'Detail Depot generated 285 premium detailing leads at an $8.69 average cost per lead. Momentum Coaching turned $325.35 of spend into $9,000 of front-end revenue. Same system: tested angles, fast follow-up, CRM attribution.',
    shots: [
      { src:'/assets/case-studies/detail-depot/detail-depot-meta-ads-results.png', alt:'Detail Depot Meta Ads results dashboard showing campaign-level lead volume and cost per lead', label:'Meta Ads results', metric:'285 leads', note:'$8.69 average cost per lead, Detail Depot' },
      { src:'/assets/case-studies/momentum-coaching/momentum-coaching-meta-ads-performance.png', alt:'Momentum Coaching Meta Ads performance dashboard showing 134 B2B leads at $2.43 average cost per lead', label:'Meta Ads performance', metric:'27.6x ROAS', note:'134 B2B leads at $2.43 CPL, Momentum Coaching' }
    ]
  },
  'google-local-service-ads': {
    kind: 'cases',
    eyebrow: 'Related proof',
    heading: 'We publish dashboards, not stock screenshots.',
    body: 'We only show real account data, so there are no decorative LSA charts here. These published projects show how we handle local calls, tracking, and follow-up for service companies, the same system every LSA lead routes into.',
    caseSlugs: ['state-termite-pest-control-legacy-modernization', 'jp-mobile-detail-automated-booking-google-ads']
  },
  'tiktok-ad-management': {
    kind: 'cases',
    eyebrow: 'Related proof',
    heading: 'The short-form playbook comes from published campaigns.',
    body: 'We do not fabricate TikTok screenshots. The approach (hooks built on buyer problems, variant testing on small budgets, retargeting from day one) is the same system behind these documented paid-social results.',
    caseSlugs: ['momentum-coaching-b2b-lead-machine', 'detail-driven-auto-spa-high-ticket-meta-ads']
  },
  'seo-aeo-geo': {
    kind: 'shots',
    eyebrow: 'Real growth',
    heading: 'From 47 monthly impressions to a brand AI engines cite.',
    body: 'Auto Monitor started at near-zero visibility. Entity-clear architecture, structured data, and answer-ready content took the site to 40+ organic clicks per day and 93,800 citations across modern AI engines.',
    shots: [
      { src:'/assets/case-studies/auto-monitor/auto-monitor-search-growth-overview.png', alt:'Auto Monitor search growth overview showing organic impressions and clicks climbing from a near-zero baseline', label:'Organic growth', metric:'40+ clicks/day', note:'From 47 monthly impressions, Auto Monitor' },
      { src:'/assets/case-studies/auto-monitor/auto-monitor-aeo-citations.png', alt:'Auto Monitor AEO report showing citations of the brand across AI answer engines', label:'AI answer citations', metric:'93.8K citations', note:'Across modern AI engines, Auto Monitor' }
    ]
  },
  'ai-implementation-agent-orchestration': {
    kind: 'shots',
    eyebrow: 'Real output',
    heading: 'Structure machines can read, output a team can trust.',
    body: 'Auto Monitor’s content was built to be machine-readable from the first page: clear entities, structured data, defined sources. The result is 93,800 citations across AI engines: the same structural discipline we bring to agent workflows.',
    shots: [
      { src:'/assets/case-studies/auto-monitor/auto-monitor-ai-engine-citations.png', alt:'Auto Monitor report showing the brand cited across AI engines including generative answer tools', label:'AI engine visibility', metric:'93.8K citations', note:'AI engines citing Auto Monitor’s structured content' }
    ]
  }
};
const proof = proofBySlug[service.slug];
const proofCases = proof.kind === 'cases'
  ? proof.caseSlugs.map(s => caseStudies.find(c => c.slug === s)).filter(Boolean)
  : [];

/* ---------- Industries fit ---------- */
const fitIndustries = detail.industriesFit
  .map(slug => industries.find(i => i.slug === slug))
  .filter(Boolean);

/* ---------- Related services (internal links) ---------- */
const relatedServicesBySlug: Record<string, string[]> = {
  'web-development': ['seo-aeo-geo', 'crm-solutions'],
  'crm-solutions': ['ai-implementation-agent-orchestration', 'google-ppc-management'],
  'google-ppc-management': ['google-local-service-ads', 'web-development'],
  'meta-advertising': ['tiktok-ad-management', 'crm-solutions'],
  'google-local-service-ads': ['google-ppc-management', 'crm-solutions'],
  'tiktok-ad-management': ['meta-advertising', 'web-development'],
  'seo-aeo-geo': ['web-development', 'ai-implementation-agent-orchestration'],
  'ai-implementation-agent-orchestration': ['crm-solutions', 'seo-aeo-geo']
};
const relatedServices = (relatedServicesBySlug[service.slug] ?? [])
  .map(slug => services.find(s => s.slug === slug))
  .filter(Boolean);

/* ---------- ContactForm subheads (preserved per-service copy) ---------- */
const ctaSubheads: Record<string, string> = {
  'web-development': 'Bring the current site, the services you want to sell more of, and the markets you want to win. We will review the page path from first impression to booked opportunity.',
  'crm-solutions': 'Show us where leads currently enter the business and where follow-up breaks. We will map the highest-impact CRM fixes first.',
  'google-ppc-management': 'Bring the account, landing pages, and conversion data. We will identify where spend is leaking before recommending a new campaign structure.',
  'meta-advertising': 'Show us the offer, past creatives, and current lead quality. We will find the gap between attention and booked opportunities.',
  'google-local-service-ads': 'We will review eligibility, profile quality, call handling, and whether LSA is a smart fit before recommending spend.',
  'tiktok-ad-management': 'Bring the offer, examples of content you like, and any past video performance. We will decide whether TikTok should be acquisition, retargeting, or creative research.',
  'seo-aeo-geo': 'We will review search coverage, page quality, technical SEO, schema, and the highest-value pages to build next.',
  'ai-implementation-agent-orchestration': 'Tell us the repetitive work slowing the team down. We will identify the safest high-leverage AI workflow to build first.'
};
const ctaSubhead = ctaSubheads[service.slug];

/* ---------- Schema ---------- */
const schema = [
  { '@context':'https://schema.org', '@type':'Service', name:service.eyebrow, provider:{ '@type':'ProfessionalService', name:site.name, url:site.url }, areaServed:'United States', description:service.description },
  { '@context':'https://schema.org', '@type':'FAQPage', mainEntity: serviceFaqs.map(f => ({ '@type':'Question', name:f.q, acceptedAnswer:{ '@type':'Answer', text:f.a }})) },
  { '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement: [
    { '@type':'ListItem', position:1, name:'Home', item:`${site.url}/` },
    { '@type':'ListItem', position:2, name:'Services', item:`${site.url}/#services` },
    { '@type':'ListItem', position:3, name:service.nav, item:`${site.url}/services/${service.slug}/` }
  ]}
];
---
<Base title={service.title} description={`${service.description} Based in St. Petersburg, Florida and serving contractors, clinics, education brands, auto businesses, and B2B service companies across the U.S.`} keywords={service.keywords} schema={schema}>
<Header />
<main>

  <!-- 1-2. Breadcrumb + service hero -->
  <section class="container svc-hero reveal">
    <div class="svc-hero-copy">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <span>Services</span> / <span aria-current="page">{service.nav}</span></nav>
      <p class="eyebrow">{service.eyebrow}</p>
      <h1>
        {titleParts ? (
          <>{titleParts.before}<span class="accent-word">{titleParts.match}</span>{titleParts.after}</>
        ) : (
          service.title
        )}
      </h1>
      <p class="svc-hero-lede">{service.description}</p>
      <div class="svc-actions">
        <a class="button primary" href="/contact/">{service.cta}</a>
        <a class="button ghost" href="#industries-fit">See industries we serve</a>
      </div>
      <p class="svc-bestwhen"><i aria-hidden="true"></i>{detail.bestWhen}</p>
    </div>
    <div class="svc-hero-visual">
      <HeroVisual {...(heroVisual.props ?? {})} />
    </div>
  </section>

  <!-- 3. The problem -->
  <section class="section">
    <div class="container svc-problem reveal">
      <div>
        <p class="eyebrow">The problem</p>
        <h2>{problemHeading}</h2>
      </div>
      <p class="svc-problem-lede">{detail.problem}</p>
    </div>
  </section>

  <!-- 4. What is included -->
  <section class="container section reveal" id="included">
    <div class="section-head">
      <p class="eyebrow">What is included</p>
      <h2>What the engagement actually <span class="accent-word">ships</span>.</h2>
      <p>Scope stays concrete. These are the four components every {service.nav} build is judged against.</p>
    </div>
    <div class="svc-included-grid">
      {detail.included.map((item, index) => (
        <article class="svc-included-card">
          <span class="svc-num">{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- 5. How we approach it -->
  <section class="container section reveal">
    <div class="section-head">
      <p class="eyebrow">How we approach it</p>
      <h2>How the work gets done.</h2>
      <p>The sequence matters: diagnose before building, build before scaling.</p>
    </div>
    <ol class="svc-steps">
      {detail.approach.map((step, index) => (
        <li class="svc-step">
          <span class="svc-step-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 5b. Behind the build photo -->
  <section class="container">
    <PhotoFrame class="reveal" ratio="16/9" alt={`Simplufy team working on ${service.nav}`} label={servicePhotos[service.slug]} src={serviceImages[service.slug]} />
  </section>

  <!-- 6. Proof -->
  <section class="container section reveal">
    <div class="section-head">
      <p class="eyebrow">{proof.eyebrow}</p>
      <h2>{proof.heading}</h2>
      <p>{proof.body}</p>
    </div>

    {proof.kind === 'rebuild' && (
      <div class="proof-grid proof-grid--pair">
        <BrowserFrame
          src="/assets/proof/state-termite/state-termite-old-red-blue-homepage.png"
          alt="Old State Termite homepage with heavy red and blue navigation and crowded banners, before the redesign"
          url="statetermite.com"
          caption="Before: legacy red and blue homepage with mixed priorities and no clear next step."
        />
        <BrowserFrame
          src="/assets/proof/state-termite/state-termite-new-green-homepage.png"
          alt="New State Termite homepage with a clean green brand system, clear hierarchy, and an above-the-fold lead form"
          url="statetermite.com"
          caption="After: focused hierarchy, a direct protection-plan CTA, and lead capture above the fold."
        />
        <div class="proof-extra">
          <BrowserFrame
            src="/assets/case-studies/venice-dive-center/venice-dive-center-new-booking-engine.png"
            alt="Venice Dive Center website rebuilt as a mobile-first booking engine with online scheduling"
            url="venicedivecenter.com"
            caption="Venice Dive Center: a dated, high-friction site rebuilt as a 24/7 booking engine."
          />
        </div>
      </div>
    )}

    {proof.kind === 'shots' && (
      <div class={`proof-grid ${proof.shots.length > 1 ? 'proof-grid--pair' : 'proof-grid--single'}`}>
        {proof.shots.map(shot => (
          <ScreenshotCard src={shot.src} alt={shot.alt} label={shot.label} metric={shot.metric} note={shot.note} />
        ))}
      </div>
    )}

    {proof.kind === 'cases' && (
      <div class="case-link-grid">
        {proofCases.map(cs => (
          <a class="case-link" href={`/case-studies/${cs.slug}/`}>
            <span class="case-link-client">{cs.client}</span>
            <strong>{cs.metric}</strong>
            <p>{cs.title}</p>
            <em>Read the case study
              <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5"/></svg>
            </em>
          </a>
        ))}
      </div>
    )}

    <a class="proof-more" href="/case-studies/">Explore all case studies
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5"/></svg>
    </a>
  </section>

  <!-- 7. Industries fit -->
  <section class="container section reveal" id="industries-fit">
    <div class="section-head">
      <p class="eyebrow">Industries fit</p>
      <h2>Where {service.nav} pays for itself first.</h2>
      <p>The playbook changes by buyer. These are the industries where this service most often turns into booked opportunities fastest.</p>
    </div>
    <div class="fit-grid">
      {fitIndustries.map(industry => (
        <a class="fit-card" href={`/industries/${industry.slug}/`}>
          <span class="icon-chip"><Icon name={industry.icon} /></span>
          <span class="fit-copy">
            <strong>{industry.nav}</strong>
            <span>{service.nav} for {industry.nav.toLowerCase()}</span>
          </span>
