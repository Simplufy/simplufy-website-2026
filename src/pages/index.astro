---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import PartnerBadges from '../components/PartnerBadges.astro';
import SignalFlow from '../components/motion/SignalFlow.astro';
import FunnelLeakScanner from '../components/motion/FunnelLeakScanner.astro';
import ServiceOrbit from '../components/motion/ServiceOrbit.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import { site, services, industries, allClientLogos } from '../data/site';
import { industryPhotos, photoSlots } from '../data/photos';
import { faqs } from '../data/faqs';
import { serviceDetails } from '../data/serviceDetails';
import { industryDetails } from '../data/industryDetails';

const serviceNav = Object.fromEntries(services.map((s) => [s.slug, s.nav]));

const leaks = [
  { title: 'Unclear offer', line: 'Visitors cannot tell what you sell, who it is for, or why they should pick you over the next tab.' },
  { title: 'Thin service pages', line: 'One generic services page cannot rank for ten different jobs or persuade ten different buyers.' },
  { title: 'Slow speed-to-lead', line: 'The lead that gets a text in five minutes books. The one that waits five hours keeps shopping.' },
  { title: 'Disconnected CRM', line: 'Forms land in an inbox, calls go untracked, and nobody can see which leads are still waiting.' },
  { title: 'Weak tracking', line: 'When nobody knows which channel booked the job, budget goes to whichever report looks busiest.' },
  { title: 'No proof above the CTA', line: 'Asking for the call before showing evidence makes every click work harder than it should.' }
];

const osSteps = [
  { num: '01', title: 'Demand Capture', desc: 'Google, Meta, LSA, TikTok, SEO, referrals, local search.' },
  { num: '02', title: 'Conversion Path', desc: 'Home, service, industry, landing, and resource pages.' },
  { num: '03', title: 'CRM Handoff', desc: 'Source, service, contact data, appointment intent.' },
  { num: '04', title: 'Follow-up', desc: 'SMS, email, missed-call, reminders, nurture.' },
  { num: '05', title: 'Reporting', desc: 'Lead source, booked opportunity, pipeline, revenue signals.' },
  { num: '06', title: 'AI Support', desc: 'Reporting summaries, research, intake, content, internal handoffs.' }
];

const resourceCards = [
  { cat: 'Search', title: 'SEO/AEO/GEO for service industries', line: 'How to structure pages so Google, maps, and AI search engines all understand who you serve.', href: '/resources/seo-aeo-geo-for-service-industries/' },
  { cat: 'CRM', title: 'CRM follow-up systems', line: 'What to fix when leads come in but booked calls, estimates, and consultations are not keeping up.', href: '/resources/crm-follow-up-system-for-booked-calls/' },
  { cat: 'Paid Media', title: 'Paid media for booked jobs', line: 'Where Google Ads, LSA, and Meta each fit when the goal is booked jobs instead of cheap form fills.', href: '/resources/google-ads-lsa-meta-for-contractors/' }
];

const schema = [
  { '@context':'https://schema.org', '@type':['LocalBusiness','ProfessionalService'], name:site.name, url:site.url, description:site.description, address:{'@type':'PostalAddress', addressLocality:site.city, addressRegion:'FL', addressCountry:'US'}, areaServed:'United States', serviceType:services.map(s=>s.eyebrow) },
  { '@context':'https://schema.org', '@type':'WebSite', name:site.name, url:site.url },
  { '@context':'https://schema.org', '@type':'Organization', name:site.name, url:site.url, logo:`${site.url}/assets/simplufy-original-logo.png` },
  { '@context':'https://schema.org', '@type':'FAQPage', mainEntity: faqs.map(f => ({ '@type':'Question', name:f.q, acceptedAnswer:{ '@type':'Answer', text:f.a }})) }
];
---
<Base title="Digital Marketing Agency for Contractors, Clinics, Education & B2B" description="Simplufy builds websites, paid ads, CRM automation, SEO/AEO/GEO, and AI systems for contractors, auto shops, med spas, education brands, and B2B service companies." keywords="digital marketing agency for contractors, med spa marketing agency, auto detailing marketing, B2B service marketing, education marketing agency, AI implementation agency" schema={schema}>
  <Header />
  <main>
    <!-- 1. HERO -->
    <section class="hero container">
      <div class="hero-copy reveal">
        <p class="eyebrow">Digital growth systems for service industries</p>
        <h1>Get found. Get chosen. <span class="accent-word">Follow up</span> before the lead goes cold.</h1>
        <p class="hero-sub">Simplufy builds the connected growth system behind companies that live on booked calls, estimates, consultations, appointments, enrollments, and sales conversations.</p>
        <div class="actions">
          <a class="button primary" href="/contact/">Book a strategy call</a>
          <a class="button ghost" href="#system">See how the system works</a>
        </div>
        <PartnerBadges />
        <p class="hero-microproof">Trusted by brands across automotive, home services, trades, specialty services, education, and B2B.</p>
      </div>
      <div class="hero-visual reveal">
        <SignalFlow />
      </div>
    </section>

    <!-- 2. LOGO MARQUEE -->
    <section class="logo-marquee-band reveal" aria-label="Client brands running on Simplufy growth systems">
      <p class="logo-marquee-label">Client brands running on Simplufy growth systems</p>
      <div class="logo-marquee">
        <div class="logo-marquee__track">
          {[...allClientLogos, ...allClientLogos].map((logo, idx) => (
            <span class:list={["logo-item", logo.tone === 'dark' && "logo-dark"]}>
              <img src={logo.src} alt={idx < allClientLogos.length ? logo.name : ''} loading="lazy" aria-hidden={idx >= allClientLogos.length ? 'true' : undefined} />
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. PROBLEM -->
    <section class="container section">
      <div class="section-head reveal">
        <p class="eyebrow">The core problem</p>
        <h2>Most marketing problems are really <span class="accent-word">system problems</span>.</h2>
        <p>A polished website will not save slow follow-up. Cheap leads will not fix weak positioning. SEO content will not work if the site is thin. Simplufy connects the pieces so your marketing does not depend on one random tactic working forever.</p>
      </div>
      <div class="scanner-wrap reveal">
        <FunnelLeakScanner />
      </div>
      <div class="leak-grid reveal">
        {leaks.map((l) => (
          <div class="leak-card">
            <h3><span class="leak-dot" aria-hidden="true"></span>{l.title}</h3>
            <p>{l.line}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. OPERATING SYSTEM -->
    <section class="container section" id="system">
      <div class="section-head reveal">
        <p class="eyebrow">The operating system</p>
        <h2>One connected system from first click to booked opportunity.</h2>
        <p>Traffic, pages, forms, calendars, CRM, follow-up, reporting, and AI should not live in separate silos.</p>
      </div>
      <ol class="os-flow reveal" role="list">
        {osSteps.map((step) => (
          <li class="os-step">
            <span class="os-num">{step.num}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- 5. SERVICES -->
    <section class="container section" id="services">
      <div class="services-lead reveal">
        <div class="section-head services-head">
          <p class="eyebrow">Services</p>
          <h2>The services are separate. The <span class="accent-word">strategy</span> is not.</h2>
          <p>Eight modules, one output. Every service is built to feed the next step in the system, not to live in its own silo.</p>
        </div>
        <ServiceOrbit />
      </div>
      <div class="module-grid reveal">
        {services.map((s) => (
          <a class="svc-card" href={`/services/${s.slug}/`}>
            <span class="icon-chip"><Icon name={s.icon} /></span>
            <h3>{s.nav}</h3>
            <p class="svc-desc">{s.description}</p>
            <p class="svc-best">{serviceDetails[s.slug].bestWhen}</p>
            <em class="svc-cta">{s.cta} →</em>
          </a>
        ))}
      </div>
    </section>

    <!-- 6. INDUSTRIES -->
    <section class="container section" id="industries">
      <div class="section-head reveal">
        <p class="eyebrow">Industries</p>
        <h2>Specific pages for <span class="accent-word">specific buyers</span>, not vague “local business” copy.</h2>
        <p>Each industry has different offers, seasonality, search behavior, trust signals, and sales cycles. The structure changes by market while the system stays consistent.</p>
      </div>
      <div class="ind-grid reveal">
        {industries.map((i) => (
          <a class="ind-card" href={`/industries/${i.slug}/`}>
            <PhotoFrame class="ind-thumb" ratio="16/10" alt={`${i.nav} work`} label={industryPhotos[i.slug]} />
            <div class="ind-head">
              <span class="icon-chip"><Icon name={i.icon} /></span>
              <h3>{i.nav}</h3>
            </div>
            <p class="ind-outcome">{industryDetails[i.slug].outcome}</p>
            <ul class="ind-tags" role="list">
              {industryDetails[i.slug].services.slice(0, 3).map((slug) => (
                <li>{serviceNav[slug]}</li>
              ))}
            </ul>
            <em class="ind-go">View industry →</em>
          </a>
        ))}
      </div>
    </section>

    <!-- 7. PROOF -->
    <section class="container section">
      <div class="section-head reveal">
        <p class="eyebrow">Proof</p>
        <h2>Real systems. Real campaigns. Real <span class="accent-word">booked opportunity</span> signals.</h2>
      </div>
      <div class="stat-band reveal">
        <div><strong>$83,260</strong><span>Pipeline value, Detail Depot</span></div>
        <div><strong>1,087</strong><span>Google clicks, JP Mobile Detail</span></div>
        <div><strong>Since 1933</strong><span>Legacy brand modernized, State Termite</span></div>
        <div><strong>27.6x</strong><span>ROAS, Momentum Coaching</span></div>
      </div>
      <div class="proof-cases">
        <div class="featured-case-card reveal">
          <div>
            <p class="eyebrow">Featured growth system</p>
            <h3>Detail Depot: $2,000 to $12,000+/month</h3>
            <p>285 premium detailing and coating leads, $83,260 in tracked pipeline value, and a 10x+ ad return from one connected Meta, website, and CRM system.</p>
            <div class="actions"><a class="button ghost" href="/case-studies/detail-depot-auto-detailing-growth-system/">Read the Detail Depot case study</a></div>
          </div>
          <BrowserFrame src="/assets/case-studies/detail-depot/detail-depot-meta-ads-results.png" alt="Detail Depot Meta Ads results showing 285 leads and cost per lead" url="ads.simplufy.com" />
        </div>
        <div class="featured-case-card reveal">
          <div>
            <p class="eyebrow">Featured legacy modernization</p>
            <h3>State Termite: a 1933 brand, modernized</h3>
            <p>A 93-year pest control brand moved from a dated red-and-blue legacy site into a clean lead-capture, call-tracking, and review-growth engine.</p>
            <div class="actions"><a class="button ghost" href="/case-studies/state-termite-pest-control-legacy-modernization/">Read the State Termite case study</a></div>
          </div>
          <BrowserFrame src="/assets/proof/state-termite/state-termite-new-green-homepage.png" alt="State Termite modernized website homepage" url="statetermite.com" />
        </div>
      </div>
      <div class="actions"><a class="button primary" href="/case-studies/">View case studies</a></div>
    </section>

    <!-- 8. HOW IT WORKS -->
    <section class="container section">
      <div class="section-head reveal">
        <p class="eyebrow">How we work</p>
        <h2>Find the <span class="accent-word">leak</span> before spending more money.</h2>
      </div>
      <div class="loop reveal">
        <ol class="loop-steps" role="list">
          <li class="loop-step">
            <span class="loop-num">01</span>
            <b>Audit</b>
            <span class="loop-desc">We look at your pages, tracking, CRM, ads, rankings, offers, and follow-up process.</span>
          </li>
          <li class="loop-step">
            <span class="loop-num">02</span>
            <b>Build</b>
            <span class="loop-desc">We create the pages, campaigns, automations, reporting, and AI workflows that the business actually needs.</span>
          </li>
          <li class="loop-step">
            <span class="loop-num">03</span>
            <b>Improve</b>
            <span class="loop-desc">We use search data, ad data, CRM data, and sales feedback to keep tightening the system.</span>
          </li>
        </ol>
        <div class="loop-return" aria-hidden="true">
          <span class="loop-track"><i></i></span>
          <span class="loop-label">
            <svg viewBox="0 0 12 12" width="12" height="12" fill="none" focusable="false" aria-hidden="true"><path d="M10 6a4 4 0 1 1-1.2-2.85M10 1.4v2.1H7.9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            The loop keeps tightening
          </span>
        </div>
      </div>
    </section>

    <!-- 8b. WHO YOU'RE WORKING WITH -->
    <section class="container section">
      <div class="team-strip reveal">
        <PhotoFrame class="team-photo" ratio="4/5" alt="The Simplufy team" label={photoSlots.founder} />
        <div>
          <p class="eyebrow">Who you’re working with</p>
          <h2>A small team that treats your pipeline like <span class="accent-word">our own</span>.</h2>
          <p class="team-copy">Simplufy is a focused growth-systems team based in St. Petersburg, Florida, building websites, ads, CRM, search, and AI systems for service companies across the U.S. You work directly with the people doing the work, not an account layer between you and the build.</p>
          <div class="actions"><a class="button ghost" href="/contact/">Book a strategy call</a></div>
        </div>
      </div>
    </section>

    <!-- 9. RESOURCES PREVIEW -->
    <section class="container section">
      <div class="section-head reveal">
        <p class="eyebrow">Resources</p>
        <h2>Search content that can turn into rankings, sales assets, and AI visibility.</h2>
      </div>
      <div class="res-grid reveal">
        {resourceCards.map((r) => (
          <a class="res-card" href={r.href}>
            <span class="res-cat">{r.cat}</span>
            <h3>{r.title}</h3>
            <p>{r.line}</p>
            <em class="res-go">Read →</em>
          </a>
        ))}
      </div>
      <div class="actions"><a class="button ghost" href="/resources/">Browse resources</a></div>
    </section>

    <!-- 9b. FULL-BLEED CTA BAND -->
    <section class="cta-band reveal" aria-label="Book a strategy call">
      <div class="cta-band__media"><PhotoFrame tone="dark" alt="Simplufy workspace" label={photoSlots.ctaBand} /></div>
      <div class="cta-band__scrim" aria-hidden="true"></div>
      <div class="container cta-band__inner">
        <h2>Find the <span class="accent-word">leak</span> before spending more money.</h2>
        <p>We walk through what is working, what is leaking, and what to fix first across your website, ads, CRM, search, and follow-up.</p>
        <a class="button primary" href="/contact/">Book a strategy call</a>
      </div>
    </section>

    <!-- 10. FAQ + CONTACT -->
    <FAQ />
    <div class="container"><ContactForm headline="Book a strategy call with Simplufy" subhead="Pick a time and we will walk through what is working, what is leaking, and what should be fixed first." /></div>
  </main>
  <Footer />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero-microproof {
    margin: var(--s-4) 0 0;
    color: var(--text-subtle);
    font-size: var(--fs-small);
    font-weight: var(--fw-med);
    line-height: 1.5;
    max-width: 56ch;
  }

  /* ---------- Problem / leak cards ---------- */
  .scanner-wrap {
    margin-top: var(--s-6);
  }
  .leak-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: var(--s-5);
  }
  .leak-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
    padding: 22px;
    display: grid;
    gap: 8px;
    align-content: start;
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .leak-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }
  .leak-card h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 16px;
    letter-spacing: var(--tracking-tight);
    font-weight: var(--fw-semi);
  }
  .leak-dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .leak-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.55;
  }

  /* ---------- Operating system flow ---------- */
  .os-flow {
    --os-gap: 20px;
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--os-gap);
  }
  .os-step {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-sm);
    padding: 18px 16px;
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .os-num {
    display: inline-flex;
    width: max-content;
    padding: 3px 8px;
    border-radius: var(--r-pill);
    background: var(--accent-weak);
    color: var(--accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
  }
  .os-step h3 {
    margin: 0;
    font-size: 15px;
    letter-spacing: var(--tracking-tight);
    font-weight: var(--fw-semi);
    line-height: var(--lh-snug);
  }
  .os-step p {
    margin: 0;
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.5;
  }
  /* Thin connector + chevron between steps */
  .os-step:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 50%;
    right: calc(-1 * var(--os-gap));
    width: var(--os-gap);
    height: 1px;
    background: var(--border-strong);
  }
  .os-step:not(:last-child)::before {
    content: "";
    position: absolute;
    top: 50%;
    right: calc(-1 * var(--os-gap) + 2px);
    width: 5px;
    height: 5px;
    border-top: 1px solid var(--border-strong);
    border-right: 1px solid var(--border-strong);
    transform: translateY(-50%) rotate(45deg);
  }

  /* ---------- Services ---------- */
  .services-lead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, .9fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }
  .services-head {
    margin: 0;
  }
  .module-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: var(--s-7);
  }
  .svc-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
    padding: 22px;
    color: inherit;
    text-decoration: none;
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .svc-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }
  .svc-card h3 {
    margin: 4px 0 0;
    font-size: 17px;
    letter-spacing: var(--tracking-tight);
    font-weight: var(--fw-semi);
  }
  .svc-desc {
    margin: 0;
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.55;
  }
  .svc-best {
    margin: 0;
    color: var(--text-subtle);
    font-size: 14px;
    line-height: 1.5;
  }
  .svc-cta {
    margin-top: auto;
    padding-top: 6px;
    font-style: normal;
    font-weight: var(--fw-semi);
    font-size: 14px;
    color: var(--accent);
  }

  /* ---------- Industries ---------- */
  .ind-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: var(--s-6);
  }
  .ind-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
    padding: 22px;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .ind-card .ind-thumb { margin: -22px -22px 6px; }
  .ind-card .ind-thumb :global(.photoframe__img),
  .ind-card .ind-thumb :global(.photoframe__ph) { border-radius: 0; border-left: 0; border-right: 0; border-top: 0; }
  .team-strip h2 { font-size: var(--fs-h2); line-height: var(--lh-snug); letter-spacing: var(--tracking-display); margin: 6px 0 0; }
  .team-strip .team-copy { color: var(--text-muted); font-size: var(--fs-body-lg); line-height: var(--lh-body); margin: var(--s-4) 0 var(--s-6); max-width: 52ch; }
  .ind-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }
  .ind-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ind-head h3 {
    margin: 0;
    font-size: 17px;
    letter-spacing: var(--tracking-tight);
    font-weight: var(--fw-semi);
  }
  .ind-outcome {
    margin: 0;
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.55;
  }
  .ind-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .ind-tags li {
    padding: 3px 9px;
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    background: var(--surface-sunken);
    color: var(--text-subtle);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .ind-go {
    margin-top: auto;
    padding-top: 4px;
    font-style: normal;
    font-weight: var(--fw-semi);
    font-size: 14px;
    color: var(--accent);
  }

  /* ---------- Proof ---------- */
  .proof-cases {
    margin-top: var(--s-6);
  }

  /* ---------- How it works loop ---------- */
  .loop {
    margin-top: var(--s-6);
  }
  .loop-steps {
    --loop-gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--loop-gap);
  }
  .loop-step {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
    padding: 24px;
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .loop-num {
    display: inline-flex;
    width: max-content;
    padding: 3px 8px;
