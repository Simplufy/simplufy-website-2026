---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQ from '../components/FAQ.astro';
import { site, services, industries, faqs, resources, caseStudies, clientLogos } from '../data/site';
const schema = [{ '@context':'https://schema.org', '@type':['LocalBusiness','ProfessionalService'], name:site.name, url:site.url, description:site.description, address:{'@type':'PostalAddress', addressLocality:site.city, addressRegion:'FL', addressCountry:'US'}, areaServed:'United States', serviceType:services.map(s=>s.eyebrow) }, { '@context':'https://schema.org', '@type':'WebSite', name:site.name, url:site.url }, { '@context':'https://schema.org', '@type':'FAQPage', mainEntity: faqs.map(f => ({ '@type':'Question', name:f.q, acceptedAnswer:{ '@type':'Answer', text:f.a }})) }];
---
<Base title="Digital Marketing Agency for Contractors, Clinics, Education & B2B" description="Simplufy builds websites, paid ads, CRM automation, SEO/AEO/GEO, and AI systems for contractors, auto shops, med spas, education brands, and B2B service companies." keywords="digital marketing agency for contractors, med spa marketing agency, auto detailing marketing, B2B service marketing, education marketing agency, AI implementation agency" schema={schema}>
  <Header />
  <main>
    <section class="hero container">
      <div class="hero-copy reveal">
        <p class="eyebrow">Digital growth systems for service industries</p>
        <h1>Get found. Get chosen. <span class="accent-word">Follow up</span> before the lead goes cold.</h1>
        <p class="hero-sub">Simplufy builds the website, Google PPC, Meta, LSA, TikTok, CRM, search, and AI systems behind companies that live on booked calls, estimates, consultations, appointments, and enrollments.</p>
        <div class="actions"><a class="button primary" href="/contact/">Book a strategy call</a><a class="button ghost" href="#industries">See industries</a></div>
      </div>
      <div class="hero-visual reveal delay">
        <div class="orbital-system" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="dashboard-card animated-dashboard">
          <div class="dash-top"><span></span><span></span><span></span></div>
          <div class="metric-row live"><b>Speed</b><span>to lead matters</span></div>
          <div class="metric-row live delay-2"><b>Search</b><span>captures demand</span></div>
          <div class="metric-row live delay-3"><b>AI</b><span>routes repetitive work</span></div>
          <div class="signal-grid"><i></i><i></i><i></i><i></i><i></i><i></i></div>
          <div class="automation-flow"><span>Visit</span><i></i><span>Book</span><i></i><span>CRM</span><i></i><span>Follow up</span></div>
          <p>Website, ads, CRM, SEO, and AI working from the same playbook.</p>
        </div>
      </div>
    </section>

    <section class="client-strip container"><p>Trusted by brands across automotive, home services, trades, and specialty services.</p><div class="logo-marquee" aria-label="Client logos"><div class="logo-track">{[...clientLogos, ...clientLogos].map((logo) => <span><img src={logo.src} alt={logo.name} loading="lazy" /></span>)}</div></div></section>

    <section class="container section" id="services"><div class="section-head"><p class="eyebrow">What we fix</p><h2>Most marketing problems are really <span class="accent-word">system problems</span>.</h2><p>A nice website will not save slow follow-up. Cheap leads will not fix weak positioning. SEO content will not work if the site is thin. Simplufy connects the pieces so your marketing does not depend on one random tactic working forever.</p></div><div class="card-grid services-grid">{services.map(s => <a class="service-card" href={`/services/${s.slug}/`}><span>{s.icon}</span><h3>{s.nav}</h3><p>{s.description}</p><em>{s.cta} →</em></a>)}</div></section>

    <section class="split-section"><div class="container split"><div><p class="eyebrow">The Simplufy approach</p><h2>Built for companies where every <span class="accent-word">missed lead</span> costs real money.</h2></div><div><p>Roofers need inspection requests. Detailers need coating jobs. Med spas need consultations. B2B firms need qualified calls. Schools, coaches, and training companies need inquiries that turn into enrollments. The strategy changes by industry, but the fundamentals stay the same: clear offer, strong pages, search demand, clean tracking, fast follow-up, and proof.</p></div></div></section>

    <section class="container section media-showcase"><div class="section-head"><p class="eyebrow">Proof you can understand</p><h2>Marketing should be clear enough to <span class="accent-word">see what is working</span>.</h2><p>Instead of vague reports, Simplufy builds visible systems: modern storefronts, booking paths, campaign data, CRM follow-up, and search visibility that show how real buyers move from first click to booked opportunity.</p></div><div class="media-grid"><div class="media-card photo media-animated"><svg class="media-animation" viewBox="0 0 280 180" aria-hidden="true"><defs><linearGradient id="webGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#ff5a50;stop-opacity:0.15"/><stop offset="100%" style="stop-color:#0a0a0a;stop-opacity:0"/></linearGradient></defs><rect x="20" y="20" width="240" height="140" rx="8" fill="url(#webGrad)" stroke="rgba(255,255,255,0.12)"/><rect x="20" y="20" width="240" height="28" rx="8" fill="rgba(255,255,255,0.04)"/><circle cx="32" cy="34" r="4" class="dot dot1"/><circle cx="46" cy="34" r="4" class="dot dot2"/><circle cx="60" cy="34" r="4" class="dot dot3"/><rect x="35" y="58" width="80" height="8" rx="2" class="bar bar1"/><rect x="35" y="74" width="120" height="6" rx="2" class="bar bar2"/><rect x="35" y="88" width="100" height="6" rx="2" class="bar bar3"/><rect x="140" y="58" width="100" height="70" rx="4" class="img-placeholder"/><rect x="150" y="78" width="80" height="40" rx="2" class="img-inner"/><span>Web presence</span><strong>Conversion pages that make the offer clear and build trust fast</strong></svg></div><div class="media-card video media-animated"><svg class="media-animation" viewBox="0 0 280 180" aria-hidden="true"><defs><linearGradient id="flowGrad" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" style="stop-color:#ff5a50;stop-opacity:0.2"/><stop offset="50%" style="stop-color:#ff5a50;stop-opacity:0.05"/><stop offset="100%" style="stop-color:#0a0a0a;stop-opacity:0"/></linearGradient></defs><rect x="20" y="20" width="240" height="140" rx="8" fill="url(#flowGrad)" stroke="rgba(255,255,255,0.12)"/><circle cx="60" cy="60" r="14" class="flow-node node1"/><circle cx="140" cy="60" r="14" class="flow-node node2"/><circle cx="220" cy="60" r="14" class="flow-node node3"/><line x1="74" y1="60" x2="126" y2="60" class="flow-line"/><line x1="154" y1="60" x2="206" y2="60" class="flow-line"/><circle cx="100" cy="100" r="10" class="flow-node node4"/><circle cx="180" cy="100" r="10" class="flow-node node5"/><line x1="140" y1="74" x2="140" y2="90" class="flow-line vert"/><line x1="100" y1="100" x2="180" y2="100" class="flow-line horiz"/><span>Booking path</span><strong>Service pages, scheduling, and follow-up built around real buyer intent</strong></svg></div><div class="media-card photo media-animated"><svg class="media-animation" viewBox="0 0 280 180" aria-hidden="true"><defs><linearGradient id="perfGrad" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" style="stop-color:#ff5a50;stop-opacity:0.18"/><stop offset="100%" style="stop-color:#0a0a0a;stop-opacity:0"/></linearGradient></defs><rect x="20" y="20" width="240" height="140" rx="8" fill="url(#perfGrad)" stroke="rgba(255,255,255,0.12)"/><rect x="35" y="50" width="12" height="80" rx="2" class="perf-bar bar1"/><rect x="55" y="70" width="12" height="60" rx="2" class="perf-bar bar2"/><rect x="75" y="40" width="12" height="90" rx="2" class="perf-bar bar3"/><rect x="95" y="60" width="12" height="70" rx="2" class="perf-bar bar4"/><rect x="115" y="55" width="12" height="75" rx="2" class="perf-bar bar5"/><circle cx="180" cy="70" r="28" class="pulse-ring"/><circle cx="180" cy="70" r="18" class="pulse-dot"/><line x1="145" y1="110" x2="215" y2="110" class="trend-line"/><polyline points="145,110 160,95 175,105 190,85 205,95 215,80" class="trend-path"/><span>Performance</span><strong>Lead, booking, pipeline, revenue, and search signals connected in one view</strong></svg></div></div></section>

    <section class="container section" id="industries"><div class="section-head"><p class="eyebrow">Industries</p><h2>Specific pages for <span class="accent-word">specific buyers</span>, not vague “local business” copy.</h2><p>Each industry has different offers, seasonality, search behavior, trust signals, and sales cycles. The site is structured so we can keep adding pages around the exact markets you want to win.</p></div><div class="industry-grid">{industries.map(i => <a class="industry-card" href={`/industries/${i.slug}/`}><h3>{i.title}</h3><p>{i.description}</p></a>)}</div></section>

    <section class="container section results" id="results"><div><p class="eyebrow">Client results</p><h2>Real growth across <span class="accent-word">web, paid, CRM, SEO, and automation</span>.</h2><p>The proof library now shows how different growth systems work in the real world: paid acquisition for auto detailers, legacy website modernization for home services, high-ticket B2B lead generation, booking-engine builds for service operators, and SEO/AEO visibility for premium brands.</p><div class="actions"><a class="button primary" href="/case-studies/">View case studies</a></div></div><div class="proof-cards result-proof-cards"><div><figure><img src="/assets/case-studies/detail-depot/detail-depot-meta-ads-results.png" alt="Detail Depot Meta Ads and pipeline performance screenshot" loading="lazy" /></figure><b>$83,260</b><h3>Detail Depot pipeline</h3><p>Tracked opportunity value from a connected Meta Ads, website, and CRM system.</p></div><div><figure><img src="/assets/proof/state-termite/state-termite-new-green-homepage.png" alt="State Termite modern website redesign screenshot" loading="lazy" /></figure><b>Since 1933</b><h3>State Termite modernization</h3><p>A 93-year local brand moved from a dated web presence into a cleaner lead capture, call tracking, and review-growth engine.</p></div><div><figure><img src="/assets/case-studies/momentum-coaching/momentum-coaching-meta-ads-performance.png" alt="Momentum Coaching Meta Ads performance dashboard screenshot" loading="lazy" /></figure><b>27.6x</b><h3>Momentum Coaching ROAS</h3><p>High-ticket B2B coaching campaign that produced $9,000 from $325.35 in ad spend.</p></div></div></section>

    <section class="container section"><div class="section-head"><p class="eyebrow">Client work</p><h2>Proof, screenshots, and <span class="accent-word">case studies</span> from real campaigns.</h2><p>The case study library now includes Detail Depot's paid acquisition system, JP Mobile Detail's booking and Google Search system, the Detail Driven ecosystem's unified brand network and cross-brand automations, Always Fresh Detailing's Las Vegas luxury positioning build, Detail Driven's high-ticket Jackson Hole Meta Ads campaign, Momentum Coaching's 27.6x B2B lead machine, State Termite's 93-year legacy modernization, Venice Dive Center's booking-engine transformation, and Auto Monitor's luxury SEO/AEO engine, with screenshots, metrics, and full breakdowns.</p></div><div class="featured-case-card"><div><p class="eyebrow">Featured auto detailing result</p><h3>How Detail Depot scaled from $2,000 to $12,000+/month</h3><p>Naperville ceramic coating and premium detailing campaign with 285 leads, $83,260 in pipeline value, and a 10x+ ad return.</p><a class="button primary" href="/case-studies/detail-depot-auto-detailing-growth-system/">View Detail Depot results</a></div><figure><img src="/assets/case-studies/detail-depot/detail-depot-meta-ads-results.png" alt="Detail Depot Meta Ads results screenshot showing campaign lead volume and cost per lead" loading="lazy" /></figure></div><div class="featured-case-card"><div><p class="eyebrow">Featured booking engine result</p><h3>How JP Mobile Detail automated bookings and won Google Search</h3><p>Powell, Ohio mobile detailing campaign with 1,087 Google clicks, $0.44 average CPC, and 31 primary bookings at $15.51 CPA.</p><a class="button primary" href="/case-studies/jp-mobile-detail-automated-booking-google-ads/">View JP Mobile Detail results</a></div><figure><img src="/assets/case-studies/jp-mobile-detail/jp-mobile-detail-google-ads-performance.png" alt="JP Mobile Detail Google Ads campaign performance dashboard" loading="lazy" /></figure></div><div class="featured-case-card"><div><p class="eyebrow">Featured legacy modernization</p><h3>How State Termite dragged a 1933 brand into the modern age</h3><p>A 93-year local pest control brand moved from a dated red/blue web presence into a cleaner green lead capture, call tracking, and review-growth engine.</p><a class="button primary" href="/case-studies/state-termite-pest-control-legacy-modernization/">View State Termite results</a></div><figure><img src="/assets/proof/state-termite/state-termite-new-green-homepage.png" alt="State Termite modern website homepage screenshot" loading="lazy" /></figure></div><div class="featured-case-card"><div><p class="eyebrow">Featured booking transformation</p><h3>How Venice Dive Center turned a brochure into a booking engine</h3><p>Florida dive shop replaced a broken legacy site with a mobile-first booking system for courses, charters, rentals, and refills.</p><a class="button primary" href="/case-studies/venice-dive-center-booking-engine/">View Venice Dive Center results</a></div><figure><img src="/assets/case-studies/venice-dive-center/venice-dive-center-new-booking-engine.png" alt="Venice Dive Center modern booking website screenshot" loading="lazy" /></figure></div></section>

    <section class="container section"><div class="section-head"><p class="eyebrow">Resources</p><h2>Search content that can turn into <span class="accent-word">rankings, sales assets, and AI visibility</span>.</h2><p>The resource hub is built for articles around services, industries, problems, comparisons, and buying questions.</p></div><div class="industry-grid">{resources.map(r => <a class="industry-card" href={`/resources/${r.slug}/`}><p class="eyebrow">{r.category}</p><h3>{r.title}</h3><p>{r.description}</p></a>)}</div></section>

    <section class="container section process" id="process"><div class="section-head"><p class="eyebrow">How we work</p><h2>Find the <span class="accent-word">leak</span> before spending more money.</h2></div><ol><li><b>Audit</b><span>We look at your pages, tracking, CRM, ads, rankings, offers, and follow-up process.</span></li><li><b>Build</b><span>We create the pages, campaigns, automations, reporting, and AI workflows that the business actually needs.</span></li><li><b>Improve</b><span>We use search data, ad data, CRM data, and sales feedback to keep tightening the system.</span></li></ol></section>

    <FAQ />
    <div class="container"><ContactForm headline="Book a strategy call with Simplufy" subhead="Pick a time and we will walk through what is working, what is leaking, and what should be fixed first." /></div>
  </main>
  <Footer />
</Base>
