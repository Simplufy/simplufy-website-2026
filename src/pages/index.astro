---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import DeviceFrame from '../components/DeviceFrame.astro';
import ScreenshotCard from '../components/ScreenshotCard.astro';
import PartnerBadges from '../components/PartnerBadges.astro';
import { site, services, industries, faqs, resources, wallLogos } from '../data/site';
const schema = [{ '@context':'https://schema.org', '@type':['LocalBusiness','ProfessionalService'], name:site.name, url:site.url, description:site.description, address:{'@type':'PostalAddress', addressLocality:site.city, addressRegion:'FL', addressCountry:'US'}, areaServed:'United States', serviceType:services.map(s=>s.eyebrow) }, { '@context':'https://schema.org', '@type':'WebSite', name:site.name, url:site.url }, { '@context':'https://schema.org', '@type':'FAQPage', mainEntity: faqs.map(f => ({ '@type':'Question', name:f.q, acceptedAnswer:{ '@type':'Answer', text:f.a }})) }];
---
<Base title="Digital Marketing Agency for Contractors, Clinics, Education & B2B" description="Simplufy builds websites, paid ads, CRM automation, SEO/AEO/GEO, and AI systems for contractors, auto shops, med spas, education brands, and B2B service companies." keywords="digital marketing agency for contractors, med spa marketing agency, auto detailing marketing, B2B service marketing, education marketing agency, AI implementation agency" schema={schema}>
  <Header />
  <main>
    <section class="hero container">
      <div class="hero-copy reveal">
        <p class="eyebrow">Digital growth systems for service industries</p>
        <h1>Get found. Get chosen. <span class="accent-word">Follow up</span> before the lead goes cold.</h1>
        <p class="hero-sub">Simplufy builds the website, Google PPC, Meta, LSA, TikTok, CRM, search, and AI systems behind companies that live on booked calls, estimates, consultations, appointments, and enrollments.</p>
        <div class="actions"><a class="button primary" href="/contact/">Book a strategy call</a><a class="button ghost" href="#industries">See industries</a></div>
        <PartnerBadges />
      </div>
      <div class="hero-visual reveal">
        <BrowserFrame src="/assets/case-studies/detail-depot/detail-depot-website-preview.png" alt="Detail Depot website built by Simplufy" url="detaildepot.com" />
        <div class="hero-stat-chip"><strong>$83,260</strong><span>pipeline tracked</span></div>
      </div>
    </section>

    <section class="container">
      <div class="logo-wall-static reveal">
        <p>Trusted by brands across automotive, home services, trades, and specialty services</p>
        <ul>{wallLogos.map((logo) => <li><img src={logo.src} alt={logo.name} loading="lazy" /></li>)}</ul>
      </div>
    </section>

    <section class="container section" id="services"><div class="section-head reveal"><p class="eyebrow">What we fix</p><h2>Most marketing problems are really <span class="accent-word">system problems</span>.</h2><p>A nice website will not save slow follow-up. Cheap leads will not fix weak positioning. SEO content will not work if the site is thin. Simplufy connects the pieces so your marketing does not depend on one random tactic working forever.</p></div><div class="card-grid services-grid reveal">{services.map(s => <a class="service-card" href={`/services/${s.slug}/`}><span class="icon-chip"><Icon name={s.icon} /></span><h3>{s.nav}</h3><p>{s.description}</p><em>{s.cta} →</em></a>)}</div></section>

    <section class="split-section"><div class="container split reveal"><div><p class="eyebrow">The Simplufy approach</p><h2>Built for companies where every <span class="accent-word">missed lead</span> costs real money.</h2></div><div><p>Roofers need inspection requests. Detailers need coating jobs. Med spas need consultations. B2B firms need qualified calls. Schools, coaches, and training companies need inquiries that turn into enrollments. The strategy changes by industry, but the fundamentals stay the same: clear offer, strong pages, search demand, clean tracking, fast follow-up, and proof.</p></div></div></section>

    <section class="container section"><div class="section-head reveal"><p class="eyebrow">Proof you can understand</p><h2>Marketing should be clear enough to <span class="accent-word">see what is working</span>.</h2><p>Instead of vague reports, Simplufy builds visible systems: modern storefronts, booking paths, campaign data, CRM follow-up, and search visibility that show how real buyers move from first click to booked opportunity.</p></div>
      <div class="proof-showcase-grid reveal">
        <BrowserFrame src="/assets/case-studies/detail-depot/detail-depot-website-preview.png" alt="Detail Depot conversion-focused website" url="detaildepot.com" caption="Web presence — conversion pages that make the offer clear and build trust fast." />
        <DeviceFrame src="/assets/case-studies/jp-mobile-detail/jp-mobile-detail-booking-engine.png" alt="JP Mobile Detail mobile booking engine" caption="Booking path — scheduling built around real buyer intent." />
        <ScreenshotCard src="/assets/case-studies/detail-depot/detail-depot-meta-ads-results.png" alt="Detail Depot Meta Ads performance" label="Performance" metric="$83,260" note="Lead, booking, pipeline, and revenue signals in one connected view." />
      </div>
    </section>

    <section class="container section" id="industries"><div class="section-head reveal"><p class="eyebrow">Industries</p><h2>Specific pages for <span class="accent-word">specific buyers</span>, not vague “local business” copy.</h2><p>Each industry has different offers, seasonality, search behavior, trust signals, and sales cycles. The site is structured so we can keep adding pages around the exact markets you want to win.</p></div><div class="industry-grid reveal">{industries.map(i => <a class="industry-card" href={`/industries/${i.slug}/`}><div class="card-head"><span class="icon-chip"><Icon name={i.icon} /></span><h3>{i.nav}</h3></div><p>{i.description}</p></a>)}</div></section>

    <section class="container section results" id="results"><div class="reveal"><p class="eyebrow">Client results</p><h2>Real growth across <span class="accent-word">web, paid, CRM, SEO, and automation</span>.</h2><p>The proof library shows how different growth systems work in the real world: paid acquisition for auto detailers, legacy website modernization for home services, high-ticket B2B lead generation, booking-engine builds, and SEO/AEO visibility for premium brands.</p><div class="actions"><a class="button primary" href="/case-studies/">View case studies</a></div></div>
      <div class="proof-cards result-proof-cards reveal">
        <ScreenshotCard src="/assets/case-studies/detail-depot/detail-depot-meta-ads-results.png" alt="Detail Depot Meta Ads and pipeline performance" label="Detail Depot" metric="$83,260" note="Pipeline value from a connected Meta Ads, website, and CRM system." />
        <ScreenshotCard src="/assets/proof/state-termite/state-termite-new-green-homepage.png" alt="State Termite modernized website" label="State Termite" metric="Since 1933" note="A 93-year brand moved into a clean lead-capture and review engine." />
        <ScreenshotCard src="/assets/case-studies/momentum-coaching/momentum-coaching-meta-ads-performance.png" alt="Momentum Coaching Meta Ads performance" label="Momentum Coaching" metric="27.6x" note="High-ticket B2B campaign that produced $9,000 from $325.35 in spend." />
      </div>
    </section>

    <section class="container section"><div class="section-head reveal"><p class="eyebrow">Client work</p><h2>Proof, screenshots, and <span class="accent-word">case studies</span> from real campaigns.</h2><p>Real builds with screenshots, metrics, and full breakdowns — paid acquisition, automated booking, ecosystem automation, legacy modernization, and luxury SEO/AEO engines.</p></div>
      <div class="featured-case-card reveal"><div><p class="eyebrow">Featured auto detailing result</p><h3>How Detail Depot scaled from $2,000 to $12,000+/month</h3><p>Naperville ceramic coating and premium detailing campaign with 285 leads, $83,260 in pipeline value, and a 10x+ ad return.</p><a class="button primary" href="/case-studies/detail-depot-auto-detailing-growth-system/">View Detail Depot results</a></div><BrowserFrame src="/assets/case-studies/detail-depot/detail-depot-meta-ads-results.png" alt="Detail Depot Meta Ads results showing lead volume and cost per lead" url="ads.simplufy.com" /></div>
      <div class="featured-case-card reveal"><div><p class="eyebrow">Featured booking engine result</p><h3>How JP Mobile Detail automated bookings and won Google Search</h3><p>Powell, Ohio mobile detailing campaign with 1,087 Google clicks, $0.44 average CPC, and 31 primary bookings at $15.51 CPA.</p><a class="button primary" href="/case-studies/jp-mobile-detail-automated-booking-google-ads/">View JP Mobile Detail results</a></div><BrowserFrame src="/assets/case-studies/jp-mobile-detail/jp-mobile-detail-google-ads-performance.png" alt="JP Mobile Detail Google Ads campaign performance dashboard" url="ads.google.com" /></div>
      <div class="featured-case-card reveal"><div><p class="eyebrow">Featured legacy modernization</p><h3>How State Termite dragged a 1933 brand into the modern age</h3><p>A 93-year local pest control brand moved from a dated red/blue web presence into a cleaner lead capture, call tracking, and review-growth engine.</p><a class="button primary" href="/case-studies/state-termite-pest-control-legacy-modernization/">View State Termite results</a></div><BrowserFrame src="/assets/proof/state-termite/state-termite-new-green-homepage.png" alt="State Termite modern website homepage" url="statetermite.com" /></div>
      <div class="featured-case-card reveal"><div><p class="eyebrow">Featured booking transformation</p><h3>How Venice Dive Center turned a brochure into a booking engine</h3><p>Florida dive shop replaced a broken legacy site with a mobile-first booking system for courses, charters, rentals, and refills.</p><a class="button primary" href="/case-studies/venice-dive-center-booking-engine/">View Venice Dive Center results</a></div><BrowserFrame src="/assets/case-studies/venice-dive-center/venice-dive-center-new-booking-engine.png" alt="Venice Dive Center modern booking website" url="venicedivecenter.com" /></div>
    </section>

    <section class="container section"><div class="stat-band reveal"><div><strong>$83,260</strong><span>Pipeline tracked — Detail Depot</span></div><div><strong>27.6x</strong><span>ROAS — Momentum Coaching</span></div><div><strong>1,087</strong><span>Google clicks — JP Mobile Detail</span></div><div><strong>Since 1933</strong><span>Legacy brand modernized — State Termite</span></div></div></section>

    <section class="container section"><div class="section-head reveal"><p class="eyebrow">Resources</p><h2>Search content that turns into <span class="accent-word">rankings, sales assets, and AI visibility</span>.</h2><p>The resource hub is built for articles around services, industries, problems, comparisons, and buying questions.</p></div><div class="resource-list reveal">{resources.map(r => <a href={`/resources/${r.slug}/`}><span class="r-cat">{r.category}</span><div><span class="r-title">{r.title}</span><p class="r-desc">{r.description}</p></div><span class="r-go">Read →</span></a>)}</div></section>

    <section class="container section process" id="process"><div class="section-head reveal"><p class="eyebrow">How we work</p><h2>Find the <span class="accent-word">leak</span> before spending more money.</h2></div><ol class="reveal"><li><b>Audit</b><span>We look at your pages, tracking, CRM, ads, rankings, offers, and follow-up process.</span></li><li><b>Build</b><span>We create the pages, campaigns, automations, reporting, and AI workflows that the business actually needs.</span></li><li><b>Improve</b><span>We use search data, ad data, CRM data, and sales feedback to keep tightening the system.</span></li></ol></section>

    <FAQ />
    <div class="container"><ContactForm headline="Book a strategy call with Simplufy" subhead="Pick a time and we will walk through what is working, what is leaking, and what should be fixed first." /></div>
  </main>
  <Footer />
</Base>
