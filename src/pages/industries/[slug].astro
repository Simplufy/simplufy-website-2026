---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContactForm from '../../components/ContactForm.astro';
import FAQ from '../../components/FAQ.astro';
import Icon from '../../components/Icon.astro';
import SignalFlow from '../../components/motion/SignalFlow.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import ScreenshotCard from '../../components/ScreenshotCard.astro';
import { industries, services, site } from '../../data/site';
import { industryDetails } from '../../data/industryDetails';

export function getStaticPaths(){ return industries.map(industry => ({ params:{ slug: industry.slug }, props:{ industry }})); }

const { industry } = Astro.props;
const detail = industryDetails[industry.slug];
const pageUrl = `${site.url}/industries/${industry.slug}/`;

const fitServices = detail.services
  .map((slug) => services.find((s) => s.slug === slug))
  .filter((s): s is (typeof services)[number] => Boolean(s));

const firstSentence = (text: string) => {
  const idx = text.indexOf('. ');
  return idx === -1 ? text : `${text.slice(0, idx)}.`;
};

/* Lowercased industry label that survives mid-sentence use. */
const navLower =
  industry.nav === 'B2B Services' ? 'B2B services'
  : industry.nav === 'Education & Training' ? 'education and training'
  : industry.nav.toLowerCase();

/* "Everything points at the same outcome: ..." */
const outcomeLine = detail.outcome.charAt(0).toLowerCase() + detail.outcome.slice(1);

/* Industry-specific FAQ label + CTA copy (subheads re-housed from the previous template). */
const localCopy: Record<string, { operator: string; headline: string; subhead: string }> = {
  'auto-detailing-shops': { operator:'detailing shop', headline:'Want a growth system built for your detailing shop?', subhead:'Tell us your detail packages, average ticket, service area, and current booking process. We will review where premium buyers are dropping off.' },
  'auto-styling-shops': { operator:'styling shop', headline:'Want a quote engine built for your styling shop?', subhead:'Share your highest-value install categories, visual assets, and quoting process. We will identify the pages and campaigns most likely to attract premium projects.' },
  'roofing-companies': { operator:'roofing', headline:'Want more inspections booked from the demand you already have?', subhead:'Tell us your service area, roofing specialties, storm-season goals, and intake process. We will review the path from search to scheduled inspection.' },
  'plumbing-companies': { operator:'plumbing', headline:'Want fewer missed calls and more booked jobs?', subhead:'Share your highest-margin plumbing services, emergency coverage, and call handling workflow. We will look for the fastest lead-response improvements.' },
  'pest-control-companies': { operator:'pest control', headline:'Want more inspections and recurring plans on the books?', subhead:'Tell us which pest services matter most, your service area, and how inspections or recurring plans are currently sold. We will review the strongest growth path.' },
  'landscaping-companies': { operator:'landscaping', headline:'Want more qualified estimates for your landscape work?', subhead:'Share your main landscape services, project photos, service area, and estimate process. We will identify the best pages and campaigns to prioritize.' },
  'window-companies': { operator:'window company', headline:'Want more quote requests for your window services?', subhead:'Tell us which window services you sell, your service area, and the information needed for a good quote. We will review the page and lead-capture path.' },
  'smart-home-installers': { operator:'smart home', headline:'Want more qualified consultations for premium installs?', subhead:'Share your install categories, ideal project size, and consultation process. We will review how to make complex work easier for buyers to understand.' },
  'contractors': { operator:'contracting', headline:'Want a system that closes the estimate follow-up gap?', subhead:'Tell us your trade, average job value, service area, and how estimates are currently booked. We will review where qualified project demand is leaking.' },
  'med-spas': { operator:'med spa', headline:'Want more consultations that actually show up?', subhead:'Share your core treatments, compliance constraints, booking workflow, and best offers. We will review the safest path to more qualified consultations.' },
  'b2b-services': { operator:'B2B', headline:'Want qualified sales conversations you do not have to wait for?', subhead:'Tell us the buyer you want, the problem you solve, and the current sales cycle. We will review how to make your expertise clearer and easier to act on.' },
  'education-training': { operator:'education', headline:'Want more inquiries that become enrollments?', subhead:'Share your programs, audiences, enrollment goals, and current inquiry process. We will review the pages and workflows that should be strengthened first.' }
};
const local = localCopy[industry.slug] ?? localCopy['contractors'];

/* Proof blocks only where real client material exists. */
const proofKind =
  industry.slug === 'auto-detailing-shops' ? 'detailing'
  : industry.slug === 'auto-styling-shops' ? 'styling'
  : industry.slug === 'pest-control-companies' ? 'pest'
  : (industry.slug === 'b2b-services' || industry.slug === 'education-training') ? 'momentum'
  : 'generic';

const schema = [
  { '@context':'https://schema.org', '@type':'WebPage', name:industry.title, url:pageUrl, description:industry.description },
  { '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:[
    { '@type':'ListItem', position:1, name:'Home', item:`${site.url}/` },
    { '@type':'ListItem', position:2, name:'Industries', item:`${site.url}/#industries` },
    { '@type':'ListItem', position:3, name:industry.nav, item:pageUrl }
  ]},
  { '@context':'https://schema.org', '@type':'FAQPage', mainEntity: detail.faqs.map(f => ({ '@type':'Question', name:f.q, acceptedAnswer:{ '@type':'Answer', text:f.a }})) }
];
---
<Base title={industry.title} description={`${industry.description} Simplufy builds web, CRM, Google PPC, Meta, LSA, TikTok, SEO/AEO/GEO, and AI systems for companies that sell services and need more qualified opportunities.`} keywords={industry.keywords} schema={schema}>
<Header />
<main>

  <section class="container ind-hero reveal">
    <div class="ind-hero__copy">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/#industries">Industries</a> / <span>{industry.nav}</span></nav>
      <p class="eyebrow">Industry growth systems</p>
      <h1>{detail.h1}</h1>
      <p class="ind-hero__sub">{detail.intro}</p>
      <div class="actions">
        <a class="button primary" href="/contact/">Book a strategy call</a>
        <a class="button ghost" href="#builds">See what we build</a>
      </div>
    </div>
    <div class="ind-hero__visual">
      <SignalFlow variant="mini" />
    </div>
  </section>

  <section class="container section">
    <div class="section-head reveal">
      <p class="eyebrow">What buyers need</p>
      <h2>What buyers check before they <span class="accent-word">contact</span> you.</h2>
      <p>Buyers compare two or three companies in one sitting. These are the checks they run before reaching out — and the signals the system is built to put in front of them first.</p>
    </div>
    <div class="needs-grid reveal">
      {detail.buyerNeeds.map((need, index) => (
        <div class="need-card">
          <div class="need-card__head"><span class="num-chip">{String(index + 1).padStart(2, '0')}</span></div>
          <p>{need}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container section" id="builds">
    <div class="section-head reveal">
      <p class="eyebrow">What Simplufy builds</p>
      <h2>What Simplufy <span class="accent-word">builds</span> for {navLower}.</h2>
      <p>Everything below points at the same outcome: {outcomeLine}</p>
    </div>
    <div class="builds-grid reveal">
      {detail.builds.map((build, index) => (
        <article class="build-card">
          <span class="num-chip">{String(index + 1).padStart(2, '0')}</span>
          <h3>{build.title}</h3>
          <p>{build.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container section">
    <div class="section-head reveal">
      <p class="eyebrow">Best-fit services</p>
      <h2>The services doing the <span class="accent-word">heavy lifting</span>.</h2>
      <p>Every industry system draws from the same eight Simplufy services. For {navLower}, these are the ones that move booked work first.</p>
    </div>
    <div class="fit-grid reveal">
      {fitServices.map((service) => (
        <a class="fit-card" href={`/services/${service.slug}/`}>
          <span class="icon-chip"><Icon name={service.icon} /></span>
          <h3>{service.nav}</h3>
          <p>{firstSentence(service.description)}</p>
          <em>Explore {service.nav} <span aria-hidden="true">→</span></em>
        </a>
      ))}
    </div>
  </section>

  <section class="container section">
    <div class="section-head reveal">
      <p class="eyebrow">Common growth leaks</p>
      <h2>Where good leads quietly <span class="accent-word">leak</span>.</h2>
      <p>The patterns we find most often in audits. None of them are exotic — they are unfinished handoffs between marketing and follow-up, and each one is fixable.</p>
    </div>
    <ul class="leak-list reveal" role="list">
      {detail.leaks.map((leak) => (
        <li class="leak-chip"><span class="leak-dot" aria-hidden="true"></span>{leak}</li>
      ))}
    </ul>
  </section>

  <section class="container section">
    <div class="section-head reveal">
      <p class="eyebrow">In practice</p>
      <h2>Example campaigns, pages, and <span class="accent-word">workflows</span>.</h2>
      <p>A sample of the concrete assets an engagement like this produces — each one wired into the CRM so the result stays measurable.</p>
    </div>
    <ol class="example-rows reveal">
      {detail.examples.map((example, index) => (
        <li>
          <span class="ex-num">{String(index + 1).padStart(2, '0')}</span>
          <p>{example}</p>
        </li>
      ))}
    </ol>
  </section>

  {proofKind === 'detailing' && (
    <section class="container section proof-section">
      <div class="section-head reveal">
        <p class="eyebrow">Proof, not promises</p>
        <h2>These systems already run in <span class="accent-word">detailing</span> shops.</h2>
        <p>Real campaign and pipeline numbers from detailing clients — the same offer pages, booking flows, and follow-up automations described above.</p>
      </div>
      <div class="stat-band proof-stats reveal">
        <div><strong>$83,260</strong><span>pipeline generated</span><em>Detail Depot</em></div>
        <div><strong>285</strong><span>leads at an $8.69 average CPL</span><em>Detail Depot — Meta Ads</em></div>
        <div><strong>1,087</strong><span>Google Ads clicks</span><em>JP Mobile Detail</em></div>
        <div><strong>$0.44</strong><span>average cost per click</span><em>JP Mobile Detail</em></div>
      </div>
      <div class="proof-split reveal">
        <BrowserFrame src="/assets/case-studies/detail-depot/detail-depot-website-preview.png" alt="Detail Depot premium auto detailing website preview" caption="Detail Depot — premium positioning built for ceramic coating and detailing buyers." />
        <div class="proof-links">
          <p class="proof-links__label">Read the full case studies</p>
          <a href="/case-studies/detail-depot-auto-detailing-growth-system/"><strong>Detail Depot</strong><span>From $2K to $12K+ months on an $83,260 pipeline</span><i aria-hidden="true">→</i></a>
          <a href="/case-studies/jp-mobile-detail-automated-booking-google-ads/"><strong>JP Mobile Detail</strong><span>Automated booking engine and $0.44 CPC Google Ads</span><i aria-hidden="true">→</i></a>
          <a href="/case-studies/always-fresh-detailing-luxury-positioning-las-vegas/"><strong>Always Fresh Detailing</strong><span>Luxury repositioning for Las Vegas vehicle owners</span><i aria-hidden="true">→</i></a>
        </div>
      </div>
    </section>
  )}

  {proofKind === 'styling' && (
    <section class="container section proof-section">
      <div class="section-head reveal">
        <p class="eyebrow">Proof, not promises</p>
        <h2>High-ticket auto work, <span class="accent-word">measured</span>.</h2>
        <p>Detail Driven sells coating, protection, and styling work in Jackson Hole. Offer-driven Meta campaigns produced 139 high-intent form leads at a $24.01 average CPL, with cross-brand CRM automation running behind the storefronts.</p>
      </div>
      <div class="proof-split reveal">
        <ScreenshotCard src="/assets/case-studies/detail-driven-auto-spa/detail-driven-meta-ads-performance.png" alt="Detail Driven Auto Spa Meta Ads campaign performance dashboard" label="Meta Ads Manager" metric="139 leads" note="$24.01 average CPL on high-ticket campaigns" />
        <div class="proof-links">
          <p class="proof-links__label">Read the full case studies</p>
          <a href="/case-studies/detail-driven-auto-spa-high-ticket-meta-ads/"><strong>Detail Driven Auto Spa</strong><span>High-ticket Meta Ads in a premium mountain market</span><i aria-hidden="true">→</i></a>
          <a href="/case-studies/detail-driven-ecosystem-cross-brand-automation/"><strong>Detail Driven Ecosystem</strong><span>Cross-brand CRM automation across a four-brand portfolio</span><i aria-hidden="true">→</i></a>
        </div>
      </div>
    </section>
  )}

  {proofKind === 'pest' && (
    <section class="container section proof-section">
      <div class="section-head reveal">
        <p class="eyebrow">Proof, not promises</p>
        <h2>A 93-year pest brand, <span class="accent-word">modernized</span>.</h2>
        <p>State Termite had operated since 1933 on a dated red-and-blue website that buried its protection plans. The rebuild leads with a clean green brand system, clear hierarchy, and an above-the-fold lead form.</p>
      </div>
      <div class="before-after reveal">
        <BrowserFrame src="/assets/proof/state-termite/state-termite-old-red-blue-homepage.png" alt="State Termite legacy red and blue website homepage before the rebuild" caption="Before — crowded banners, mixed priorities, no clear next step." />
        <BrowserFrame src="/assets/proof/state-termite/state-termite-new-green-homepage.png" alt="State Termite modern green website homepage after the rebuild" caption="After — conversion-led rebuild with a direct protection-plan CTA." />
      </div>
      <div class="proof-links proof-links--solo reveal">
        <a href="/case-studies/state-termite-pest-control-legacy-modernization/"><strong>State Termite</strong><span>How a 1933 brand moved into a modern lead-capture engine</span><i aria-hidden="true">→</i></a>
      </div>
    </section>
  )}

  {proofKind === 'momentum' && (
    <section class="container section proof-section">
      <div class="section-head reveal">
        <p class="eyebrow">Proof, not promises</p>
        {industry.slug === 'b2b-services'
          ? <h2>$325.35 in, <span class="accent-word">$9,000</span> back.</h2>
          : <h2>An offer validated at <span class="accent-word">27.6x</span> ROAS.</h2>}
        {industry.slug === 'b2b-services'
          ? <p>Momentum Coaching ran a direct-response B2B Meta campaign: 134 targeted leads at $2.43 each, three high-ticket clients, and a 27.6x return on ad spend — with every lead routed into same-day follow-up.</p>
          : <p>Momentum Coaching used founder-led creative and native lead forms to produce 134 leads at $2.43 CPL and a 27.6x ROAS — proof that education and coaching offers can be validated on micro budgets before scaling.</p>}
      </div>
      <div class="proof-split reveal">
        <ScreenshotCard src="/assets/case-studies/momentum-coaching/momentum-coaching-meta-ads-performance.png" alt="Momentum Coaching Meta Ads performance dashboard showing 134 leads at $2.43 CPL" label="Meta Ads Manager" metric="27.6x ROAS" note="134 leads at $2.43 CPL from $325.35 in test spend" />
        <div class="proof-links">
          <p class="proof-links__label">Read the full case study</p>
          <a href="/case-studies/momentum-coaching-b2b-lead-machine/"><strong>Momentum Coaching</strong><span>A B2B lead machine built on founder-led creative</span><i aria-hidden="true">→</i></a>
        </div>
      </div>
    </section>
  )}

  {proofKind === 'generic' && (
    <section class="container proof-section proof-section--quiet">
      <a class="proof-quiet reveal" href="/case-studies/">
        <span class="proof-quiet__label">Case studies</span>
        <span class="proof-quiet__text">See how these systems perform in other service industries</span>
        <span class="proof-quiet__arrow" aria-hidden="true">→</span>
      </a>
    </section>
  )}

  <FAQ items={detail.faqs} eyebrow="Industry FAQ" heading={`Questions from ${local.operator} operators.`} />

  <div class="container">
    <ContactForm mode="form" headline={local.headline} subhead={local.subhead} points={detail.builds.map((b) => b.title)} />
  </div>

</main>
<Footer />
</Base>

<style>
  /* ---------- Hero ---------- */
  .ind-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    padding-block: clamp(36px, 5.5vw, 72px) clamp(20px, 3.5vw, 44px);
  }
  .ind-hero .breadcrumb {
    color: var(--text-subtle);
    font-size: var(--fs-small);
    margin-bottom: var(--s-5);
  }
  .ind-hero .breadcrumb a {
    color: var(--text-muted);
    font-weight: var(--fw-med);
    transition: color var(--dur-fast) var(--ease);
  }
  .ind-hero .breadcrumb a:hover { color: var(--accent); }
  .ind-hero h1 {
    margin: 0 0 var(--s-4);
    font-size: clamp(29px, 3.2vw, 41px);
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    font-weight: var(--fw-bold);
    text-wrap: balance;
  }
  .ind-hero__sub {
    margin: 0;
    max-width: 56ch;
    font-size: var(--fs-body-lg);
    color: var(--text-muted);
    line-height: var(--lh-body);
  }
  .ind-hero__visual { min-width: 0; }

  /* ---------- Shared number chip ---------- */
  .num-chip {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: var(--r-sm);
    background: var(--accent-weak);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 14%, transparent);
    font-size: var(--fs-label);
    font-weight: var(--fw-bold);
    letter-spacing: 0.02em;
  }

  /* ---------- What buyers need ---------- */
  .needs-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  .need-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
    padding: var(--s-5);
    display: grid;
    gap: var(--s-4);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .need-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }
  .need-card__head {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }
  .need-card__head::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--border);
  }
  .need-card p {
    margin: 0;
    color: var(--text);
    font-size: var(--fs-body);
    line-height: 1.55;
    font-weight: var(--fw-med);
    max-width: 44ch;
  }

  /* ---------- What Simplufy builds ---------- */
  .builds-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  .build-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
    padding: clamp(24px, 3vw, 32px);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .build-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }
  .build-card h3 {
    margin: var(--s-4) 0 var(--s-2);
    font-size: var(--fs-h3);
    letter-spacing: var(--tracking-tight);
    font-weight: var(--fw-semi);
  }
  .build-card p {
    margin: 0;
    color: var(--text-muted);
    line-height: var(--lh-body);
    font-size: var(--fs-body);
  }

  /* ---------- Best-fit services ---------- */
  .fit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(215px, 1fr));
    gap: 18px;
  }
  .fit-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
    padding: var(--s-5);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .fit-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }
  .fit-card h3 {
    margin: var(--s-2) 0 0;
    font-size: var(--fs-h4);
    font-weight: var(--fw-semi);
    letter-spacing: var(--tracking-tight);
  }
  .fit-card p {
    margin: 0;
    flex: 1;
    color: var(--text-muted);
    font-size: var(--fs-small);
    line-height: 1.55;
  }
  .fit-card em {
    font-style: normal;
    color: var(--accent);
    font-weight: var(--fw-semi);
    font-size: var(--fs-small);
  }

  /* ---------- Common growth leaks ---------- */
  .leak-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    max-width: 980px;
  }
  .leak-chip {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-sm);
    color: var(--text);
    font-size: var(--fs-body);
    line-height: 1.5;
    font-weight: var(--fw-med);
  }
  .leak-dot {
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 7px;
    border-radius: var(--r-pill);
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 14%, transparent);
  }

  /* ---------- Examples ---------- */
  .example-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 880px;
  }
  .example-rows li {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: var(--s-5);
    align-items: baseline;
    padding: 20px 4px;
    border-top: 1px solid var(--border);
  }
  .example-rows li:last-child { border-bottom: 1px solid var(--border); }
  .ex-num {
    color: var(--accent);
    font-weight: var(--fw-black);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
  }
  .example-rows p {
    margin: 0;
    font-size: var(--fs-h4);
    font-weight: var(--fw-med);
    letter-spacing: var(--tracking-tight);
    color: var(--text);
  }

  /* ---------- Proof ---------- */
  .proof-split {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(20px, 3vw, 36px);
    align-items: start;
    margin-top: clamp(20px, 3vw, 32px);
  }
  .proof-stats { margin-top: 0; }
  .proof-links {
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .proof-links__label {
    margin: 0 0 2px;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-subtle);
    font-weight: var(--fw-bold);
  }
  .proof-links a {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    column-gap: 12px;
    align-items: center;
    padding: 16px 18px;
    background: var(--surface);
    border: 1px solid var(--border);
