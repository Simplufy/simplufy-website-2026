---
// PageArchitecture — Signal Flow visual for the Web Development page.
// Wireframe layers assemble into a page silhouette; side labels explain
// what each layer is doing for the buyer.
---
<div class="pa" aria-label="Page architecture: navigation, a hero that says what you do in seconds, a proof strip above the call to action, search-intent service pages, and a clear booking path">
  <div class="pa-grid">
    <!-- Nav layer -->
    <div class="pa-layer pa-nav" style="--i:0; grid-row: 1;">
      <span class="pa-logo" aria-hidden="true"></span>
      <span class="pa-menu" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="pa-nav-cta" aria-hidden="true"></span>
    </div>
    <span class="pa-leader pa-leader-empty" style="--i:0; grid-row: 1;" aria-hidden="true"></span>
    <span class="pa-label pa-label-empty" style="--i:0; grid-row: 1;" aria-hidden="true"></span>

    <!-- Hero layer -->
    <div class="pa-layer pa-hero" style="--i:1; grid-row: 2;">
      <div class="pa-hero-copy" aria-hidden="true">
        <i class="pa-line pa-line-h1"></i>
        <i class="pa-line pa-line-h1b"></i>
        <i class="pa-line pa-line-sub"></i>
        <i class="pa-cta-block"></i>
      </div>
      <span class="pa-hero-tag">Says what you do in seconds</span>
    </div>
    <span class="pa-leader" style="--i:1; grid-row: 2;" aria-hidden="true"></span>
    <span class="pa-label" style="--i:1; grid-row: 2;">Clear offer</span>

    <!-- Proof strip layer -->
    <div class="pa-layer pa-proof" style="--i:2; grid-row: 3;">
      <span class="pa-rating" aria-hidden="true">&#9733; 4.9</span>
      <span class="pa-proof-logos" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    </div>
    <span class="pa-leader" style="--i:2; grid-row: 3;" aria-hidden="true"></span>
    <span class="pa-label" style="--i:2; grid-row: 3;">Proof above the CTA</span>

    <!-- Service grid layer -->
    <div class="pa-layer pa-services" style="--i:3; grid-row: 4;" aria-hidden="true">
      {[0, 1, 2, 3, 4, 5].map(() => (
        <span class="pa-service-card"><i class="pa-line pa-line-t"></i><i class="pa-line pa-line-b"></i></span>
      ))}
    </div>
    <span class="pa-leader" style="--i:3; grid-row: 4;" aria-hidden="true"></span>
    <span class="pa-label" style="--i:3; grid-row: 4;">Search-intent pages</span>

    <!-- CTA layer -->
    <div class="pa-layer pa-cta" style="--i:4; grid-row: 5;" aria-hidden="true">
      <i class="pa-line pa-line-cta"></i>
      <i class="pa-cta-button"></i>
    </div>
    <span class="pa-leader" style="--i:4; grid-row: 5;" aria-hidden="true"></span>
    <span class="pa-label" style="--i:4; grid-row: 5;">Booking path</span>
  </div>

  <span class="pa-speed-chip"><i aria-hidden="true"></i>Fast static build</span>
</div>

<style>
  .pa {
    position: relative;
    width: 100%;
    padding-bottom: 38px; /* room for the speed chip */
  }

  .pa-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) 44px minmax(max-content, 0.6fr);
    grid-template-rows: repeat(5, auto);
    row-gap: 7px;
    align-items: center;
  }
  /* Page silhouette frame behind the layer column */
  .pa-grid::before {
    content: '';
    grid-column: 1;
    grid-row: 1 / 6;
    align-self: stretch;
    justify-self: stretch;
    margin: -12px;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: color-mix(in srgb, var(--surface-sunken) 55%, transparent);
    pointer-events: none;
  }

  /* ---- Layers (wireframe blocks) ---- */
  .pa-layer {
    grid-column: 1;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    box-shadow: var(--shadow-sm);
    animation: pa-assemble 11s var(--ease) infinite both;
    animation-delay: calc(var(--i) * 0.4s);
  }
  @keyframes pa-assemble {
    0%   { opacity: 0; transform: translateY(16px); }
    7%   { opacity: 1; transform: none; }
    88%  { opacity: 1; transform: none; }
    94%  { opacity: 0; transform: translateY(-6px); }
    100% { opacity: 0; transform: translateY(16px); }
  }

  /* Wireframe primitives */
  .pa-line {
    display: block;
    border-radius: 3px;
    background: var(--border-strong);
  }

  /* Nav */
  .pa-nav {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: 9px 12px;
  }
  .pa-logo {
    width: 11px;
    height: 11px;
    border-radius: 3.5px;
    background: var(--text);
    flex: none;
  }
  .pa-menu {
    display: flex;
    gap: 7px;
    margin-left: auto;
  }
  .pa-menu i {
    width: 22px;
    height: 3.5px;
    border-radius: 2px;
    background: var(--border-strong);
  }
  .pa-nav-cta {
    width: 34px;
    height: 12px;
    border-radius: var(--r-pill);
    background: var(--accent);
    flex: none;
  }

  /* Hero */
  .pa-hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s-4);
    padding: 16px 14px 14px;
  }
  .pa-hero-copy {
    display: flex;
    flex-direction: column;
    gap: 7px;
    flex: 1 1 auto;
    min-width: 0;
  }
  .pa-line-h1  { width: 72%; height: 9px; background: color-mix(in srgb, var(--text) 78%, #fff); }
  .pa-line-h1b { width: 48%; height: 9px; background: color-mix(in srgb, var(--text) 78%, #fff); }
  .pa-line-sub { width: 60%; height: 4px; margin-top: 2px; }
  .pa-cta-block {
    width: 62px;
    height: 15px;
    border-radius: var(--r-pill);
    background: var(--accent);
    margin-top: 4px;
  }
  .pa-hero-tag {
    flex: none;
    max-width: 44%;
    font-size: 10.5px;
    line-height: 1.35;
    font-weight: var(--fw-med);
    color: var(--text-muted);
    text-align: right;
    border: 1px dashed var(--border-strong);
    border-radius: var(--r-sm);
    padding: 5px 8px;
  }

  /* Proof strip */
  .pa-proof {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding: 8px 12px;
  }
  .pa-rating {
    font-size: 10.5px;
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-label);
    color: var(--text-muted);
    white-space: nowrap;
  }
  .pa-proof-logos {
    display: flex;
    gap: 9px;
    margin-left: auto;
  }
  .pa-proof-logos i {
    width: 26px;
    height: 9px;
    border-radius: 3px;
    background: var(--border);
  }

  /* Service grid */
  .pa-services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 7px;
    padding: 10px;
  }
  .pa-service-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 7px 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
  }
  .pa-line-t { width: 70%; height: 4px; }
  .pa-line-b { width: 45%; height: 4px; background: var(--border); }

  /* CTA */
  .pa-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 14px 12px;
  }
  .pa-line-cta { width: 46%; height: 6px; }
  .pa-cta-button {
    display: block;
    width: 72px;
    height: 16px;
    border-radius: var(--r-pill);
    background: var(--accent);
  }

  /* ---- Leader lines + labels ---- */
  .pa-leader {
    grid-column: 2;
    position: relative;
    height: 1px;
    background: var(--border-strong);
    transform-origin: left center;
    animation: pa-leader-draw 11s var(--ease) infinite both;
    animation-delay: calc(var(--i) * 0.4s);
  }
  .pa-leader::before {
    content: '';
    position: absolute;
    left: -2px;
    top: 50%;
    width: 4px;
    height: 4px;
    margin-top: -2px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  @keyframes pa-leader-draw {
    0%, 8% { transform: scaleX(0); }
    14%    { transform: scaleX(1); }
    88%    { transform: scaleX(1); }
    94%, 100% { transform: scaleX(0); }
  }

  .pa-label {
    grid-column: 3;
    padding-left: 10px;
    font-size: 12.5px;
    font-weight: var(--fw-semi);
    letter-spacing: var(--tracking-tight);
    color: var(--text);
    white-space: nowrap;
    animation: pa-label-in 11s var(--ease) infinite both;
    animation-delay: calc(var(--i) * 0.4s);
  }
  @keyframes pa-label-in {
    0%, 10% { opacity: 0; transform: translateX(-4px); }
    16%     { opacity: 1; transform: none; }
    88%     { opacity: 1; transform: none; }
    94%, 100% { opacity: 0; transform: translateX(-4px); }
  }

  .pa-leader-empty,
  .pa-label-empty {
    visibility: hidden;
    animation: none;
  }

  /* ---- Speed chip ---- */
  .pa-speed-chip {
    position: absolute;
    right: 0;
    bottom: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    box-shadow: var(--shadow-sm);
    font-size: 11px;
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .pa-speed-chip i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green-600);
  }

  /* ---- Small screens ---- */
  @media (max-width: 560px) {
    .pa-grid {
      grid-template-columns: minmax(0, 1fr) 18px max-content;
    }
    .pa-grid::before { margin: -8px; }
    .pa-label { font-size: 11px; padding-left: 7px; }
    .pa-hero-tag { display: none; }
    .pa-services { grid-template-columns: repeat(2, 1fr); }
    .pa-service-card:nth-child(n + 5) { display: none; }
  }

  /* ---- Reduced motion: fully assembled stack with labels ---- */
  @media (prefers-reduced-motion: reduce) {
    .pa-layer,
    .pa-label { animation: none; opacity: 1; transform: none; }
    .pa-leader { animation: none; transform: scaleX(1); }
    .pa-leader-empty,
    .pa-label-empty { visibility: hidden; }
  }
</style>
