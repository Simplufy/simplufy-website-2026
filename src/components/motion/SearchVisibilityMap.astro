---
// Signal Flow: search visibility knowledge graph.
// One entity ("Your company") sits at the center. Real queries ring it, and
// each query resolves to the right destination page. One connection at a time
// highlights and a signal dot travels entity -> query -> destination.
// 11 nodes total: 1 entity, 5 queries, 5 destinations.

const C = { x: 460, y: 260 };

const chains = [
  { q: "ceramic coating cost", dest: "Service page", qx: 460, qy: 135, dx: 460, dy: 30 },
  { q: "roof inspection near me", dest: "Local page", qx: 645, qy: 221, dx: 850, dy: 189 },
  { q: "CRM automation for service business", dest: "Case study", qx: 583, qy: 361, dx: 692, dy: 446 },
  { q: "med spa consultation", dest: "Industry page", qx: 337, qy: 361, dx: 228, dy: 446 },
  { q: "best pest control plan", dest: "FAQ answer", qx: 260, qy: 221, dx: 84, dy: 189 },
];

const surfaces = ["Google", "Maps", "AI answers"];
---

<figure
  class="visibility-map"
  role="img"
  aria-label="Knowledge graph of search visibility. One entity, your company, connects queries like roof inspection near me, ceramic coating cost, best pest control plan, med spa consultation, and CRM automation for service business to the right destination pages: service pages, local pages, FAQ answers, industry pages, and case studies, visible across Google, Maps, and AI answers."
>
  <header class="head">
    <span class="head-label">Search visibility map</span>
    <span class="head-chip">SEO &middot; AEO &middot; GEO</span>
  </header>

  <div class="stage">
    <svg class="wires" viewBox="0 0 920 500" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      {chains.map((c, i) => (
        <g class={`chain ch-${i}`}>
          <line class="wire spoke" x1={C.x} y1={C.y} x2={c.qx} y2={c.qy} />
          <line class="wire seg" x1={c.qx} y1={c.qy} x2={c.dx} y2={c.dy} />
        </g>
      ))}
      {chains.map((c, i) => (
        <circle
          class="flow-dot"
          r="3.5"
          style={`offset-path: path('M${C.x} ${C.y} L${c.qx} ${c.qy} L${c.dx} ${c.dy}'); animation-delay:${i * 3}s`}
        />
      ))}
    </svg>

    <div class="node center-node" style={`--x:${C.x}; --y:${C.y}`}>
      <span class="center-chip">Entity</span>
      <strong>Your company</strong>
    </div>

    {chains.map((c) => (
      <span class="node qnode" style={`--x:${c.qx}; --y:${c.qy}`}>
        <svg viewBox="0 0 12 12" aria-hidden="true"><circle cx="5" cy="5" r="3.4" /><path d="M7.6 7.6 10.4 10.4" /></svg>
        {c.q}
      </span>
    ))}

    {chains.map((c, i) => (
      <span class={`node dnode d-${i}`} style={`--x:${c.dx}; --y:${c.dy}; animation-delay:${i * 3}s`}>{c.dest}</span>
    ))}
  </div>

  <div class="list-entity">
    <span class="center-chip">Entity</span>
    <strong>Your company</strong>
  </div>
  <ul class="map-list">
    {chains.map((c) => (
      <li>
        <span class="lq">{c.q}</span>
        <i class="ltick" aria-hidden="true"></i>
        <span class="ld">{c.dest}</span>
      </li>
    ))}
  </ul>

  <footer class="surfaces">
    <span class="surfaces-label">Visible across</span>
    {surfaces.map((s) => <span class="surface-chip">{s}</span>)}
  </footer>
</figure>

<style>
  .visibility-map {
    container-type: inline-size;
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
    padding: var(--s-5) var(--s-6) var(--s-6);
  }

  /* ---- Panel head ---- */
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    margin-bottom: var(--s-5);
  }
  .head-label {
    font-size: var(--fs-label);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--text-subtle);
  }
  .head-chip {
    font-size: 11px;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    background: var(--surface-sunken);
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    padding: 4px 10px;
    white-space: nowrap;
  }

  /* ---- Graph stage ---- */
  .stage {
    position: relative;
    aspect-ratio: 920 / 500;
    max-width: 940px;
    margin-inline: auto;
  }
  .wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .wire {
    stroke: var(--border-strong);
    stroke-width: 1.2;
  }
  .spoke { opacity: 0.55; }
  .seg { opacity: 0.8; }
  .chain .wire { animation: svm-line 15s linear infinite; }
  .ch-1 .wire { animation-delay: 3s; }
  .ch-2 .wire { animation-delay: 6s; }
  .ch-3 .wire { animation-delay: 9s; }
  .ch-4 .wire { animation-delay: 12s; }
  @keyframes svm-line {
    0%, 100% { stroke: var(--border-strong); }
    3% { stroke: var(--accent); }
    17% { stroke: var(--accent); }
    23% { stroke: var(--border-strong); }
  }

  .flow-dot { display: none; }
  @supports (offset-path: path("M0 0 L1 1")) {
    .flow-dot {
      display: block;
      fill: var(--accent);
      stroke: color-mix(in srgb, var(--accent) 14%, transparent);
      stroke-width: 6;
      opacity: 0;
      animation: svm-run 15s linear infinite;
    }
  }
  @keyframes svm-run {
    0% { offset-distance: 0%; opacity: 0; }
    2% { opacity: 1; }
    15% { offset-distance: 100%; opacity: 1; }
    17.5% { offset-distance: 100%; opacity: 0; }
    100% { offset-distance: 100%; opacity: 0; }
  }

  /* ---- Nodes ---- */
  .node {
    position: absolute;
    left: calc(var(--x) / 920 * 100%);
    top: calc(var(--y) / 500 * 100%);
    transform: translate(-50%, -50%);
  }
  .center-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    text-align: center;
    padding: 12px 18px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-md);
  }
  .center-chip {
    font-size: 10px;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-subtle);
  }
  .center-node strong,
  .list-entity strong {
    font-size: 14.5px;
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--text);
    white-space: nowrap;
  }
  .qnode {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 11px;
    font-size: 12px;
    font-weight: var(--fw-semi);
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    box-shadow: var(--shadow-sm);
    white-space: nowrap;
  }
  .qnode svg {
    width: 10px;
    height: 10px;
    flex: none;
    fill: none;
    stroke: var(--text-subtle);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .dnode {
    font-size: 10.5px;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    box-shadow: var(--shadow-sm);
    padding: 6px 10px;
    white-space: nowrap;
    animation: svm-dest 15s linear infinite;
  }
  @keyframes svm-dest {
    0%, 100% { border-color: var(--border); color: var(--text-muted); }
    10% { border-color: color-mix(in srgb, var(--accent) 60%, var(--border)); color: var(--text); }
    17% { border-color: color-mix(in srgb, var(--accent) 60%, var(--border)); color: var(--text); }
    23% { border-color: var(--border); color: var(--text-muted); }
  }

  /* Slightly tighter nodes on mid-width containers */
  @container (max-width: 1100px) {
    .qnode { font-size: 11px; padding: 5px 9px; }
    .dnode { font-size: 9.5px; padding: 5px 8px; }
    .center-node { padding: 10px 14px; }
    .center-node strong { font-size: 13px; }
  }

  /* ---- Mobile: vertical query -> destination rows ---- */
  .list-entity,
  .map-list { display: none; }

  @container (max-width: 820px) {
    .visibility-map { padding: var(--s-5); }
    .stage { display: none; }
    .list-entity {
      display: flex;
      align-items: baseline;
      gap: 8px;
      padding: 10px 14px;
      margin-bottom: var(--s-4);
      background: var(--surface);
      border: 1px solid var(--border-strong);
      border-radius: var(--r-md);
      box-shadow: var(--shadow-sm);
    }
    .map-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .map-list li {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .lq {
      flex: 0 1 auto;
      min-width: 0;
      padding: 6px 11px;
      font-size: 12px;
      font-weight: var(--fw-semi);
      color: var(--text);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--r-pill);
      box-shadow: var(--shadow-sm);
    }
    .ltick {
      position: relative;
      flex: 1 0 18px;
      height: 0;
      border-top: 1px dashed var(--border-strong);
    }
    .ltick::after {
      content: "";
      position: absolute;
      right: 0;
      top: -3px;
      width: 5px;
      height: 5px;
      border-top: 1px solid var(--border-strong);
      border-right: 1px solid var(--border-strong);
      transform: rotate(45deg);
    }
    .ld {
      flex: none;
      font-size: 10px;
      font-weight: var(--fw-bold);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--r-sm);
      padding: 5px 8px;
      white-space: nowrap;
    }
  }

  /* ---- Surface badges ---- */
  .surfaces {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: var(--s-5);
  }
  .surfaces-label {
    font-size: 11px;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-subtle);
    margin-right: 4px;
  }
  .surface-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: var(--fw-semi);
    color: var(--text-muted);
    background: var(--surface-sunken);
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    padding: 4px 11px;
  }
  .surface-chip::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  /* ---- Reduced motion: all lines visible, one chain highlighted ---- */
  @media (prefers-reduced-motion: reduce) {
    .flow-dot { display: none !important; }
    .spoke { opacity: 0.5; }
    .seg { opacity: 0.75; }
    .ch-1 .wire { stroke: var(--accent); opacity: 1; }
    .d-1 {
      border-color: color-mix(in srgb, var(--accent) 60%, var(--border)) !important;
      color: var(--text) !important;
    }
  }
</style>
