---
/**
 * CRMPipeline: mini kanban board.
 * A highlighted lead card travels New Lead → … → Won on a slow 12s loop while
 * follow-up task chips (SMS, missed-call recovery, email) fade in at the early
 * stages. compact renders the first four columns for tighter placements.
 */
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props as Props;

interface LeadCard {
  title: string;
  source: string;
  time: string;
  won?: boolean;
}
interface Column {
  key: string;
  label: string;
  cards: LeadCard[];
}

const columnsAll: Column[] = [
  {
    key: 'new',
    label: 'New Lead',
    cards: [
      { title: 'Estimate request', source: 'Google PPC', time: '2m' },
      { title: 'Booking inquiry', source: 'Meta', time: '9m' },
    ],
  },
  {
    key: 'contacted',
    label: 'Contacted',
    cards: [{ title: 'Service inquiry', source: 'LSA', time: '1h' }],
  },
  {
    key: 'qualified',
    label: 'Qualified',
    cards: [{ title: 'Quote follow-up', source: 'SEO', time: '3h' }],
  },
  {
    key: 'booked',
    label: 'Booked',
    cards: [{ title: 'Consultation set', source: 'Google PPC', time: '1d' }],
  },
  {
    key: 'estimate',
    label: 'Estimate Sent',
    cards: [{ title: 'Estimate delivered', source: 'Meta', time: '4h' }],
  },
  {
    key: 'won',
    label: 'Won',
    cards: [
      { title: 'Job closed', source: 'LSA', time: '2d', won: true },
      { title: 'Deposit paid', source: 'SEO', time: '3d', won: true },
    ],
  },
];

const columns = compact ? columnsAll.slice(0, 4) : columnsAll;
const step = compact ? 3 : 2; /* seconds per column in the 12s loop */

const tasks: Record<string, { label: string; green?: boolean }> = {
  new: { label: 'SMS sent, 38s' },
  contacted: { label: 'Missed call recovered', green: true },
  qualified: { label: 'Email queued' },
};
---
<div class={`crm${compact ? ' crm--compact' : ''}`}>
  <div class="crm-bar">
    <span class="crm-bar__label">CRM Pipeline</span>
    <span class="crm-bar__chip"><i></i>Auto follow-up on</span>
  </div>
  <div class="crm-scroll">
    <div class="crm-board">
      {columns.map((col, i) => {
        const task = tasks[col.key];
        return (
          <section class={`crm-col crm-col--${col.key}`}>
            <header class="crm-col__head">
              <span>{col.label}</span>
              <b>{col.cards.length}</b>
            </header>
            <ul class="crm-cards" role="list">
              {col.cards.map((card) => (
                <li class={`crm-card${card.won ? ' crm-card--won' : ''}`}>
                  <span class="crm-card__title">{card.title}</span>
                  <span class="crm-card__meta">
                    <i class="crm-pill">{card.source}</i>
                    <em>{card.time}</em>
                  </span>
                </li>
              ))}
            </ul>
            <div class="crm-card crm-card--active" aria-hidden="true" style={`animation-delay:${i * step}s`}>
              <span class="crm-card__title">New estimate request</span>
              <span class="crm-card__meta">
                <i class="crm-pill">Google PPC</i>
                <em>now</em>
              </span>
            </div>
            {task && (
              <span
                class={`crm-task${task.green ? ' crm-task--green' : ''}`}
                aria-hidden="true"
                style={`animation-delay:${i * step + 1}s`}
              >
                {task.green ? (
                  <svg viewBox="0 0 12 12" width="10" height="10" fill="none" focusable="false">
                    <path
                      d="M2.5 6.5 5 8.8l4.4-5.4"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                ) : (
                  <i></i>
                )}
                {task.label}
              </span>
            )}
          </section>
        );
      })}
    </div>
  </div>
</div>

<style>
  .crm {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  /* ---- Top bar ---- */
  .crm-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 16px;
    background: var(--surface-sunken);
    border-bottom: 1px solid var(--border);
  }
  .crm-bar__label {
    font-size: 11px;
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-subtle);
  }
  .crm-bar__chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    font-size: 10.5px;
    font-weight: var(--fw-semi);
    color: var(--text-muted);
    white-space: nowrap;
  }
  .crm-bar__chip i {
    flex: none;
    width: 5px;
    height: 5px;
    border-radius: var(--r-pill);
    background: var(--accent);
    animation: crmPulse 3.2s var(--ease) infinite;
  }
  @keyframes crmPulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 18%, transparent); }
    50% { box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 14%, transparent); }
  }

  /* ---- Board ---- */
  .crm-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    padding: 14px;
  }
  .crm-board {
    display: grid;
    grid-template-columns: repeat(6, minmax(150px, 1fr));
    gap: 10px;
    min-width: 930px;
  }
  .crm--compact .crm-board {
    grid-template-columns: repeat(4, minmax(150px, 1fr));
    min-width: 630px;
  }
  .crm-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 218px;
    padding: 8px;
    background: var(--surface-sunken);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    scroll-snap-align: start;
  }
  .crm-col__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 2px 4px 0;
  }
  .crm-col__head span {
    font-size: 10.5px;
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-subtle);
    white-space: nowrap;
  }
  .crm-col__head b {
    font-size: 10px;
    font-weight: var(--fw-semi);
    line-height: 1;
    padding: 3px 7px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    color: var(--text-muted);
  }

  /* ---- Lead cards ---- */
  .crm-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .crm-card {
    display: grid;
    gap: 7px;
    padding: 9px 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    box-shadow: var(--shadow-sm);
  }
  .crm-card__title {
    font-size: 12px;
    font-weight: var(--fw-med);
    line-height: 1.3;
    color: var(--text);
  }
  .crm-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .crm-pill {
    font-style: normal;
    font-size: 10px;
    font-weight: var(--fw-semi);
    line-height: 1;
    letter-spacing: 0.02em;
    padding: 3px 7px;
    background: var(--surface-sunken);
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    color: var(--text-muted);
    white-space: nowrap;
  }
  .crm-card__meta em {
    font-style: normal;
    font-size: 10px;
    color: var(--text-subtle);
    white-space: nowrap;
  }
  .crm-card--won {
    border-left: 3px solid var(--green-600);
  }

  /* ---- The traveling lead card ---- */
  .crm-card--active {
    opacity: 0;
    border-color: color-mix(in srgb, var(--accent) 30%, var(--border));
    box-shadow:
      var(--shadow-sm),
      0 0 0 4px color-mix(in srgb, var(--accent) 8%, transparent);
    animation: crmHop6 12s var(--ease) infinite;
    will-change: opacity, transform;
  }
  .crm--compact .crm-card--active {
    animation-name: crmHop4;
  }
  .crm-card--active .crm-card__title::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 6px;
    border-radius: var(--r-pill);
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 14%, transparent);
    vertical-align: 1px;
  }
  /* Terminal column: the card lands as a win */
  .crm-col--won .crm-card--active,
  .crm--compact .crm-col--booked .crm-card--active {
    border-left: 3px solid var(--green-600);
    border-color: var(--border);
    border-left-color: var(--green-600);
    box-shadow:
      var(--shadow-sm),
      0 0 0 4px color-mix(in srgb, var(--green-600) 9%, transparent);
  }
  .crm-col--won .crm-card--active .crm-card__title::before,
  .crm--compact .crm-col--booked .crm-card--active .crm-card__title::before {
    background: var(--green-600);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--green-600) 14%, transparent);
  }
  /* 6 columns × 2s windows */
  @keyframes crmHop6 {
    0%    { opacity: 0; transform: translateY(6px); }
    2.5%  { opacity: 1; transform: none; }
    13.5% { opacity: 1; transform: none; }
    16.6% { opacity: 0; transform: translateY(-4px); }
    100%  { opacity: 0; transform: translateY(6px); }
  }
  /* 4 columns × 3s windows */
  @keyframes crmHop4 {
    0%   { opacity: 0; transform: translateY(6px); }
    2.5% { opacity: 1; transform: none; }
    21%  { opacity: 1; transform: none; }
    25%  { opacity: 0; transform: translateY(-4px); }
    100% { opacity: 0; transform: translateY(6px); }
  }

  /* ---- Task chips ---- */
  .crm-task {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: -2px;
    padding: 4px 9px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    box-shadow: var(--shadow-sm);
    font-size: 10px;
    font-weight: var(--fw-semi);
    line-height: 1.2;
    color: var(--text-muted);
    white-space: nowrap;
    opacity: 0;
    animation: crmTask 12s var(--ease) infinite;
  }
  .crm-task i {
    flex: none;
    width: 4px;
    height: 4px;
    border-radius: var(--r-pill);
    background: var(--accent);
  }
  .crm-task svg {
    flex: none;
  }
  .crm-task--green {
    color: var(--green-600);
    border-color: color-mix(in srgb, var(--green-600) 35%, transparent);
    background: color-mix(in srgb, var(--green-600) 6%, #fff);
  }
  @keyframes crmTask {
    0%   { opacity: 0; transform: translateY(4px); }
    4%   { opacity: 1; transform: none; }
    82%  { opacity: 1; transform: none; }
    90%  { opacity: 0; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(4px); }
  }

  /* ---- Reduced motion: card rests in Booked, all chips visible ---- */
  @media (prefers-reduced-motion: reduce) {
    .crm-bar__chip i { animation: none; }
    .crm-card--active { opacity: 0; }
    .crm-col--booked .crm-card--active { opacity: 1; transform: none; }
    .crm-task { opacity: 1; transform: none; }
  }
</style>
