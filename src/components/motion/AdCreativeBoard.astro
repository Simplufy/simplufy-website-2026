---
// Signal Flow: paid-social creative testing board.
// A row of creative angles feeds four sort buckets: Test, Winner, Retarget,
// Learn. Cards settle into buckets on a slow loop; the Winner gets a green
// tag and the Learn bucket feeds the next test.

interface Props {
  platform?: "meta" | "tiktok";
}

const { platform = "meta" } = Astro.props;
const isTikTok = platform === "tiktok";
const platformLabel = isTikTok ? "TikTok" : "Meta";
const platformNote = isTikTok ? "Short-form hooks (first 3 seconds)" : "Feed + Reels creative";

const angles = ["Hook", "Proof", "Offer", "Transformation", "Objection", "Founder voice"];

const buckets = [
  { name: "Test", card: "Hook", anim: true, delay: "0.8s" },
  { name: "Winner", card: "Proof", anim: true, delay: "4s", winner: true },
  { name: "Retarget", card: "Offer", anim: false },
  { name: "Learn", card: "Objection", anim: true, delay: "7.5s", learn: true },
];
---

<figure
  class:list={["creative-board", { "is-tiktok": isTikTok }]}
  role="img"
  aria-label={`Creative testing board for ${platformLabel} ads. Angle cards (hook, proof, offer, transformation, objection, founder voice) are sorted into Test, Winner, Retarget, and Learn buckets. The winner gets a tag, and what the Learn bucket captures feeds the next test.`}
>
  <header class="head">
    <span class="head-label">Creative system &mdash; {platformLabel}</span>
    <span class="head-chip">{platformNote}</span>
  </header>

  <div class="angles">
    {angles.map((a) => (
      <div class="angle">
        <span class="thumb" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="angle-name">{a}</span>
      </div>
    ))}
  </div>

  <div class="buckets">
    {buckets.map((b) => (
      <div class:list={["bucket", { "bucket-learn": b.learn }]}>
        <span class="bucket-name">{b.name}</span>
        <div
          class:list={["mini", { "mini-anim": b.anim }]}
          style={b.anim ? `animation-delay:${b.delay}` : undefined}
        >
          <i class="mini-thumb" aria-hidden="true"></i>
          <span>{b.card}</span>
          {b.winner && <em class="win-tag">Winner</em>}
        </div>
        {b.learn && (
          <span class="loop-note">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path class="loop-ring" d="M13.5 8 A5.5 5.5 0 1 1 8 2.5" />
              <path class="loop-tip" d="M5.7 1.3 8 2.5 7 5" />
            </svg>
            Feeds next test
          </span>
        )}
        {b.learn && <i class="back-tick" aria-hidden="true"></i>}
      </div>
    ))}
  </div>
</figure>

<style>
  .creative-board {
    container-type: inline-size;
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
    padding: var(--s-5) var(--s-6) var(--s-6);
  }

  /* ---- Panel head ---- */
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    margin-bottom: var(--s-6);
  }
  .head-label {
    font-size: var(--fs-label);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--text-subtle);
  }
  .head-chip {
    font-size: 11px;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    background: var(--surface-sunken);
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    padding: 4px 10px;
    white-space: nowrap;
  }

  /* ---- Creative angle row ---- */
  .angles {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--s-3);
  }
  .angle {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-sm);
  }
  .thumb {
    display: block;
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--r-sm);
    background: var(--surface-sunken);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .is-tiktok .thumb { aspect-ratio: 3 / 4; }
  .thumb i {
    position: absolute;
    left: 10%;
    right: 45%;
    top: 58%;
    height: 3px;
    border-radius: 2px;
    background: var(--border-strong);
  }
  .thumb i:nth-child(2) {
    top: 72%;
    right: 30%;
    opacity: 0.7;
  }
  .thumb i:nth-child(3) {
    top: 14%;
    right: auto;
    width: 24%;
    height: 26%;
    border-radius: 4px;
    background: var(--border);
  }
  .angle-name {
    font-size: 12.5px;
    font-weight: var(--fw-semi);
    color: var(--text);
    padding-left: 2px;
  }

  /* ---- Sort buckets ---- */
  .buckets {
    margin-top: 34px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-3);
  }
  .bucket {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 112px;
    padding: 10px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--surface-sunken) 55%, #fff);
  }
  .bucket-name {
    font-size: 10.5px;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-subtle);
  }
  .mini {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 9px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    box-shadow: var(--shadow-sm);
    font-size: 12.5px;
    font-weight: var(--fw-semi);
    color: var(--text);
  }
  .mini-anim {
    opacity: 0;
    animation: acb-settle 16s var(--ease) infinite;
  }
  .mini-thumb {
    width: 18px;
    height: 14px;
    flex: none;
    border-radius: 3px;
    background: var(--surface-sunken);
    border: 1px solid var(--border-strong);
  }
  .is-tiktok .mini-thumb {
    width: 12px;
    height: 16px;
  }
  .win-tag {
    margin-left: auto;
    font-style: normal;
    font-size: 10px;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--green-600);
    background: color-mix(in srgb, var(--green-600) 10%, #fff);
    border: 1px solid color-mix(in srgb, var(--green-600) 30%, var(--border));
    border-radius: var(--r-pill);
    padding: 2px 6px;
    white-space: nowrap;
    opacity: 0;
    animation: acb-tag 16s var(--ease) infinite;
    animation-delay: 5s;
  }

  @keyframes acb-settle {
    0% { opacity: 0; transform: translateY(-14px); }
    4% { opacity: 1; transform: translateY(0); }
    90% { opacity: 1; transform: translateY(0); }
    97%, 100% { opacity: 0; transform: translateY(0); }
  }
  @keyframes acb-tag {
    0% { opacity: 0; transform: translateY(2px); }
    4% { opacity: 1; transform: none; }
    84% { opacity: 1; transform: none; }
    92%, 100% { opacity: 0; transform: none; }
  }

  /* ---- Learn bucket: loop back to the next test ---- */
  .loop-note {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: var(--fw-semi);
    color: var(--text-muted);
  }
  .loop-note svg {
    width: 13px;
    height: 13px;
    flex: none;
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .loop-ring {
    stroke-dasharray: 3 3;
    animation: acb-dash 6s linear infinite;
  }
  @keyframes acb-dash {
    to { stroke-dashoffset: -24; }
  }
  .back-tick {
    position: absolute;
    top: -25px;
    right: 22px;
    height: 24px;
    width: 0;
    border-left: 1px dashed var(--border-strong);
  }
  .back-tick::after {
    content: "";
    position: absolute;
    top: 0;
    left: -3.5px;
    width: 6px;
    height: 6px;
    border-left: 1px solid var(--border-strong);
    border-top: 1px solid var(--border-strong);
    transform: rotate(45deg);
  }

  /* ---- Small containers: wrapped card row, 2x2 buckets ---- */
  @container (max-width: 700px) {
    .creative-board { padding: var(--s-5); }
    .angles { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .buckets {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: var(--s-5);
    }
    .back-tick { display: none; }
  }

  /* ---- Reduced motion: cards pre-sorted into buckets ---- */
  @media (prefers-reduced-motion: reduce) {
    .mini-anim,
    .win-tag { opacity: 1 !important; transform: none !important; }
  }
</style>
