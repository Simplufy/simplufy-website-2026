---
import { services, industries } from '../data/site';

const STATEMENT = 'Built for booked calls, estimates, consultations, appointments, and enrollments.';
const oneLine = (text: string, max = 90) =>
  text.length <= max
    ? text
    : text.slice(0, max + 1).replace(/\s+\S*$/, '').replace(/[,;:.]$/, '') + '…';
---
<header class="site-header">
  <a class="brand" href="/" aria-label="Simplufy home"><img class="brand-img" src="/assets/simplufy-s-mark.png" alt="" /><span>Simplufy</span></a>
  <nav class="desktop-nav" aria-label="Primary navigation">
    <div class="nav-item has-dropdown">
      <a class="nav-trigger" href="/#services">Services</a>
      <div class="dropdown-menu services-menu">
        <a class="dropdown-overview" href="/#services"><strong>Services overview</strong><span>See the full Simplufy service stack.</span></a>
        <div class="dropdown-kicker">What we build</div>
        {services.map(service => <a class="dropdown-card" href={`/services/${service.slug}/`}><strong>{service.nav}</strong><span>{oneLine(service.description)}</span><em>Open service page →</em></a>)}
        <div class="dropdown-statement">{STATEMENT}</div>
      </div>
    </div>
    <div class="nav-item has-dropdown">
      <a class="nav-trigger" href="/#industries">Industries</a>
      <div class="dropdown-menu industries-menu">
        <a class="dropdown-overview" href="/#industries"><strong>Industries overview</strong><span>Browse the markets Simplufy is built to support.</span></a>
        <div class="dropdown-kicker">Who we help</div>
        {industries.map(industry => <a class="dropdown-card" href={`/industries/${industry.slug}/`}><strong>{industry.nav}</strong><span>{oneLine(industry.description)}</span><em>Open industry page →</em></a>)}
        <div class="dropdown-statement">{STATEMENT}</div>
      </div>
    </div>
    <a href="/case-studies/">Case Studies</a>
    <a href="/resources/">Resources</a>
    <a href="/contact/">Contact</a>
  </nav>
  <a class="nav-cta" href="/contact/">Book a call</a>
  <button class="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu-drawer">
    <span class="hamburger-line"></span>
    <span class="hamburger-line"></span>
    <span class="hamburger-line"></span>
  </button>
</header>
<div class="mobile-menu-portal">
  <div class="mobile-menu-overlay" aria-hidden="true"></div>
  <div class="mobile-menu-drawer" id="mobile-menu-drawer" aria-label="Mobile navigation">
    <div class="mobile-menu-header">
      <a class="brand" href="/"><img class="brand-img" src="/assets/simplufy-s-mark.png" alt="" /><span>Simplufy</span></a>
      <button class="mobile-menu-close" aria-label="Close menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    <div class="mobile-menu-content">
      <div class="mobile-nav-section">
        <span class="mobile-nav-label">Services</span>
        {services.map(service => <a class="mobile-nav-link" href={`/services/${service.slug}/`}>{service.nav}</a>)}
      </div>
      <div class="mobile-nav-section">
        <span class="mobile-nav-label">Industries</span>
        {industries.map(industry => <a class="mobile-nav-link" href={`/industries/${industry.slug}/`}>{industry.nav}</a>)}
      </div>
      <div class="mobile-nav-section">
        <span class="mobile-nav-label">Company</span>
        <a class="mobile-nav-link" href="/case-studies/">Case Studies</a>
        <a class="mobile-nav-link" href="/resources/">Resources</a>
        <a class="mobile-nav-link" href="/contact/">Contact</a>
      </div>
      <a class="mobile-cta" href="/contact/">Book a strategy call</a>
    </div>
  </div>
</div>

<style>
  .site-header {
    transition: background-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .site-header.is-scrolled {
    background: rgba(255, 255, 255, .96);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }
  .dropdown-statement {
    grid-column: 1 / -1;
    margin-top: var(--s-2);
    padding: var(--s-3) var(--s-3) var(--s-1);
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 13px;
    line-height: var(--lh-snug);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
  }
</style>

<script>
  const menuBtn = document.querySelector('.mobile-menu-btn');
  const drawer = document.querySelector('.mobile-menu-drawer');
  const overlay = document.querySelector('.mobile-menu-overlay');
  const closeBtn = document.querySelector('.mobile-menu-close');
  function toggleMenu() {
    const isOpen = drawer.classList.contains('open');
    drawer.classList.toggle('open');
    overlay.classList.toggle('open');
    menuBtn.setAttribute('aria-expanded', String(!isOpen));
    document.body.style.overflow = !isOpen ? 'hidden' : '';
  }
  menuBtn?.addEventListener('click', toggleMenu);
  closeBtn?.addEventListener('click', toggleMenu);
  overlay?.addEventListener('click', toggleMenu);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && drawer?.classList.contains('open')) toggleMenu(); });

  const header = document.querySelector('.site-header');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
