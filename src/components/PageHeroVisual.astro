---
interface VisualItem {
  label: string;
  value?: string;
}

interface VisualProps {
  badge: string;
  icon: string;
  title: string;
  items: VisualItem[];
  flow: string[];
  theme?: string;
  kind?: string;
}

const { visual } = Astro.props as { visual: VisualProps };
const themeClass = 'theme-red';
const kindClass = visual.kind ? `visual-${visual.kind}` : 'visual-system';
const sceneDots = Array.from({ length: 9 });
---
<div class={`page-hero-visual ${themeClass} ${kindClass}`} aria-hidden="true">
  <div class="orbital-system page-orbit"><span></span><span></span><span></span></div>
  <div class="visual-scene">
    {sceneDots.map((_, index) => <span class={`scene-dot dot-${index + 1}`}></span>)}
  </div>

  <div class="hero-object object-car"><i class="car-body"></i><i class="car-top"></i><i class="wheel one"></i><i class="wheel two"></i><i class="scan-line"></i><i class="data one"></i><i class="data two"></i><i class="data three"></i></div>
  <div class="hero-object object-landscape"><i class="sun"></i><i class="blade one"></i><i class="blade two"></i><i class="blade three"></i><i class="tree"></i><i class="mower-path"></i></div>
  <div class="hero-object object-roof"><i class="roof"></i><i class="house"></i><i class="storm one"></i><i class="storm two"></i><i class="pin"></i></div>
  <div class="hero-object object-plumbing"><i class="pipe main"></i><i class="pipe vertical"></i><i class="drop one"></i><i class="drop two"></i><i class="gauge"></i></div>
  <div class="hero-object object-pest"><i class="bug body"></i><i class="bug head"></i><i class="leg l1"></i><i class="leg l2"></i><i class="leg r1"></i><i class="leg r2"></i><i class="radar"></i></div>
  <div class="hero-object object-windows"><i class="window-frame"></i><i class="shine one"></i><i class="shine two"></i><i class="quote-card"></i></div>
  <div class="hero-object object-smart"><i class="home"></i><i class="wifi one"></i><i class="wifi two"></i><i class="wifi three"></i><i class="node one"></i><i class="node two"></i></div>
  <div class="hero-object object-medspa"><i class="face"></i><i class="spark one"></i><i class="spark two"></i><i class="spark three"></i><i class="treatment"></i></div>
  <div class="hero-object object-education"><i class="book left"></i><i class="book right"></i><i class="cap"></i><i class="progress"></i></div>
  <div class="hero-object object-crm"><i class="pipeline p1"></i><i class="pipeline p2"></i><i class="pipeline p3"></i><i class="pipeline p4"></i><i class="lead-card"></i></div>
  <div class="hero-object object-search"><i class="search-box"></i><i class="result r1"></i><i class="result r2"></i><i class="result r3"></i><i class="cursor"></i></div>
  <div class="hero-object object-meta"><i class="phone"></i><i class="bubble b1"></i><i class="bubble b2"></i><i class="heart"></i><i class="retarget"></i></div>
  <div class="hero-object object-lsa"><i class="map"></i><i class="pin big"></i><i class="badge"></i><i class="call"></i></div>
  <div class="hero-object object-tiktok"><i class="video v1"></i><i class="video v2"></i><i class="video v3"></i><i class="play"></i></div>
  <div class="hero-object object-ai"><i class="core"></i><i class="node n1"></i><i class="node n2"></i><i class="node n3"></i><i class="link l1"></i><i class="link l2"></i><i class="link l3"></i></div>
  <div class="hero-object object-web"><i class="browser"></i><i class="hero-block"></i><i class="card c1"></i><i class="card c2"></i><i class="code"></i></div>
  <div class="hero-object object-b2b"><i class="briefcase"></i><i class="chart"></i><i class="dot d1"></i><i class="dot d2"></i><i class="dot d3"></i></div>
  <div class="hero-object object-contractor"><i class="helmet"></i><i class="beam one"></i><i class="beam two"></i><i class="estimate"></i></div>

  <div class="visual-card animated-dashboard">
    <div class="visual-topline">
      <span>{visual.badge}</span>
      <i>{visual.icon}</i>
    </div>
    <h3>{visual.title}</h3>
    <div class="visual-metrics">
      {visual.items.map((item, index) => (
        <div class={`visual-metric delay-${index + 1}`}>
          <b>{item.label}</b>
          {item.value && <span>{item.value}</span>}
        </div>
      ))}
    </div>
    <div class="automation-flow visual-flow">
      {visual.flow.map((step, index) => (
        <>
          <span>{step}</span>
          {index < visual.flow.length - 1 && <i></i>}
        </>
      ))}
    </div>
  </div>
</div>
