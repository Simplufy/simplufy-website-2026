---
interface Props {
  src?: string;
  alt: string;
  label?: string;      // shot description, shown in placeholder mode
  ratio?: string;      // e.g. '4/3', '3/2', '16/9', '1/1'
  caption?: string;
  class?: string;
  tone?: 'light' | 'dark';
}
const { src, alt, label = 'Photo', ratio = '4/3', caption, class: cls = '', tone = 'light' } = Astro.props;
---
<figure class={`photoframe photoframe--${tone} ${cls}`} style={`--pf-ratio:${ratio}`}>
  {src ? (
    <img class="photoframe__img" src={src} alt={alt} loading="lazy" decoding="async" />
  ) : (
    <div class="photoframe__ph" role="img" aria-label={`Placeholder: ${label}`}>
      <svg class="photoframe__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="4" width="18" height="16" rx="2"/>
        <circle cx="8.5" cy="9.5" r="1.6"/>
        <path d="M21 16l-5-5L7 20"/>
      </svg>
      <span class="photoframe__tag">Add photo</span>
      <span class="photoframe__label">{label}</span>
    </div>
  )}
  {caption && <figcaption class="photoframe__cap">{caption}</figcaption>}
</figure>
