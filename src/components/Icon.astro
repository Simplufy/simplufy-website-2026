---
import { icons } from '../data/icons';
interface Props { name: string; size?: number; class?: string; }
const { name, size = 24, class: cls = '' } = Astro.props;
const inner = icons[name] || icons.default;
---
<svg class={`icon ${cls}`} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={inner}></svg>
