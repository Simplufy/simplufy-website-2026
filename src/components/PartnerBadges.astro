---
interface Props { items?: string[]; label?: string; }
const { items = ['Meta Ads', 'Google PPC', 'Google LSA', 'TikTok Ads', 'SEO / AEO / GEO'], label = 'Channels we manage' } = Astro.props;
---
<div class="partner-badges">
  {label && <span class="partner-badges__label">{label}</span>}
  <ul>
    {items.map((i) => <li><span class="partner-badges__dot" aria-hidden="true"></span>{i}</li>)}
  </ul>
</div>
